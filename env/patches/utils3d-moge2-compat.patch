+def depth_map_to_point_map(
+    depth: torch.Tensor,
+    intrinsics: torch.Tensor,
+    extrinsics: torch.Tensor = None,
+) -> torch.Tensor:
+    """
+    Unproject depth map to 3D point map.
+
+    Args:
+        depth (torch.Tensor): [..., height, width] depth map
+        intrinsics (torch.Tensor): [..., 3, 3] camera intrinsics matrix (normalized, OpenCV convention)
+        extrinsics (torch.Tensor): [..., 4, 4] camera extrinsics matrix (optional)
+
+    Returns:
+        points (torch.Tensor): [..., height, width, 3] 3D point map
+    """
+    height, width = depth.shape[-2:]
+    uv = image_uv(height, width, device=depth.device, dtype=depth.dtype)  # (H, W, 2)
+    pts = transforms.unproject_cv(
+        uv.reshape(-1, 2),
+        depth.reshape(*depth.shape[:-2], -1),
+        extrinsics=extrinsics[..., None, :, :] if extrinsics is not None else None,
+        intrinsics=intrinsics[..., None, :, :],
+    )
+    pts = pts.reshape(*depth.shape[:-2], height, width, 3)
+    return pts
