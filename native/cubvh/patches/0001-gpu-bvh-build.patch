+constexpr uint32_t kThreads = 256;
+inline uint32_t n_blocks(uint32_t n) { return (n + kThreads - 1) / kThreads; }
+
+#define LBVH_CUDA_CHECK(x)                                                                        \
+    do {                                                                                          \
+        cudaError_t _lbvh_err = (x);                                                              \
+        if (_lbvh_err != cudaSuccess)                                                             \
+            throw std::runtime_error(std::string("LBVH CUDA error: ") + cudaGetErrorString(_lbvh_err)); \
+    } while (0)
+
+// ---------------------------------------------------------------------------
+// Stage 1: scene AABB of triangle centroids. Two-stage block reduction (no
+// atomics, no host readback -- the result stays on device and is read
+// directly by the Morton-code kernel below). This is the *centroid* AABB
+// (used only to pick the Morton quantization domain); per-node geometric
+// AABBs (used for query pruning) are computed separately from full triangle
+// extents (BoundingBox(triangle)), matching the host builder's semantics.
+// ---------------------------------------------------------------------------
+
+__global__ void centroid_partial_reduce_kernel(
+    uint32_t n, const Triangle* __restrict__ triangles,
+    Eigen::Vector3f* __restrict__ partial_min, Eigen::Vector3f* __restrict__ partial_max
+) {
+    __shared__ Eigen::Vector3f s_min[kThreads];
+    __shared__ Eigen::Vector3f s_max[kThreads];
+
+    Eigen::Vector3f local_min = Eigen::Vector3f::Constant(std::numeric_limits<float>::infinity());
+    Eigen::Vector3f local_max = Eigen::Vector3f::Constant(-std::numeric_limits<float>::infinity());
+
+    for (uint32_t i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += blockDim.x * gridDim.x) {
+        Eigen::Vector3f c = triangles[i].centroid();
+        local_min = local_min.cwiseMin(c);
+        local_max = local_max.cwiseMax(c);
+    }
+
+    s_min[threadIdx.x] = local_min;
+    s_max[threadIdx.x] = local_max;
+    __syncthreads();
+
+    for (uint32_t stride = blockDim.x / 2; stride > 0; stride >>= 1) {
+        if (threadIdx.x < stride) {
+            s_min[threadIdx.x] = s_min[threadIdx.x].cwiseMin(s_min[threadIdx.x + stride]);
+            s_max[threadIdx.x] = s_max[threadIdx.x].cwiseMax(s_max[threadIdx.x + stride]);
+        }
+        __syncthreads();
+    }
+
+    if (threadIdx.x == 0) {
+        partial_min[blockIdx.x] = s_min[0];
+        partial_max[blockIdx.x] = s_max[0];
+    }
+}
+
+__global__ void centroid_final_reduce_kernel(
+    uint32_t n_partials, const Eigen::Vector3f* __restrict__ partial_min, const Eigen::Vector3f* __restrict__ partial_max,
+    Eigen::Vector3f* __restrict__ scene_min, Eigen::Vector3f* __restrict__ scene_max
+) {
+    __shared__ Eigen::Vector3f s_min[kThreads];
+    __shared__ Eigen::Vector3f s_max[kThreads];
+
+    Eigen::Vector3f local_min = Eigen::Vector3f::Constant(std::numeric_limits<float>::infinity());
+    Eigen::Vector3f local_max = Eigen::Vector3f::Constant(-std::numeric_limits<float>::infinity());
+
+    for (uint32_t i = threadIdx.x; i < n_partials; i += blockDim.x) {
+        local_min = local_min.cwiseMin(partial_min[i]);
+        local_max = local_max.cwiseMax(partial_max[i]);
+    }
+
+    s_min[threadIdx.x] = local_min;
+    s_max[threadIdx.x] = local_max;
+    __syncthreads();
+
+    for (uint32_t stride = blockDim.x / 2; stride > 0; stride >>= 1) {
+        if (threadIdx.x < stride) {
+            s_min[threadIdx.x] = s_min[threadIdx.x].cwiseMin(s_min[threadIdx.x + stride]);
+            s_max[threadIdx.x] = s_max[threadIdx.x].cwiseMax(s_max[threadIdx.x + stride]);
+        }
+        __syncthreads();
+    }
+
+    if (threadIdx.x == 0) {
+        scene_min[0] = s_min[0];
+        scene_max[0] = s_max[0];
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Stage 2: 30-bit Morton codes (10 bits/axis) over the centroid AABB.
+// ---------------------------------------------------------------------------
+
+__device__ __forceinline__ uint32_t expand_bits10(uint32_t v) {
+    v &= 0x3ffu;
+    v = (v | (v << 16)) & 0xff0000ffu;
+    v = (v | (v << 8))  & 0x0f00f00fu;
+    v = (v | (v << 4))  & 0xc30c30c3u;
+    v = (v | (v << 2))  & 0x49249249u;
+    return v;
+}
+
+__global__ void morton_code_kernel(
+    uint32_t n, const Triangle* __restrict__ triangles,
+    const Eigen::Vector3f* __restrict__ scene_min, const Eigen::Vector3f* __restrict__ scene_max,
+    uint32_t* __restrict__ codes, uint32_t* __restrict__ indices
+) {
+    uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+
+    Eigen::Vector3f diag = (*scene_max - *scene_min).cwiseMax(1e-12f);
+    Eigen::Vector3f rel = (triangles[i].centroid() - *scene_min).cwiseQuotient(diag);
+
+    uint32_t x = (uint32_t)std::min(std::max(rel.x() * 1024.0f, 0.0f), 1023.0f);
+    uint32_t y = (uint32_t)std::min(std::max(rel.y() * 1024.0f, 0.0f), 1023.0f);
+    uint32_t z = (uint32_t)std::min(std::max(rel.z() * 1024.0f, 0.0f), 1023.0f);
+
+    codes[i] = (expand_bits10(x) << 2) | (expand_bits10(y) << 1) | expand_bits10(z);
+    indices[i] = i;
+}
+
+__global__ void gather_by_permutation_kernel(
+    uint32_t n, const Triangle* __restrict__ src, const uint32_t* __restrict__ perm, Triangle* __restrict__ dst
+) {
+    uint32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    dst[i] = src[perm[i]];
+}
+
+// ---------------------------------------------------------------------------
+// Stage 3: Karras (2012) binary radix-tree hierarchy from sorted Morton
+// codes. Internal nodes are indexed [0, n-2]; internal node 0 is always the
+// root (a property of the construction). Leaves are indexed [0, n-1] in
+// sorted (Morton) order. Child references use the sign to distinguish
+// leaf/internal: value >= 0 => internal node id; value < 0 => leaf, with
+// leaf id = -value-1. This is a *construction-time-only* encoding, distinct
+// from the final TriangleBvhNode::left_idx/right_idx leaf-range encoding
+// produced by the flatten pass further down.
+// ---------------------------------------------------------------------------
+
+__device__ __forceinline__ int32_t lbvh_delta(const uint32_t* __restrict__ codes, int32_t n, int32_t i, int32_t j) {
+    if (j < 0 || j >= n) return -1;
+    uint32_t ci = codes[i], cj = codes[j];
+    if (ci != cj) return __clz(ci ^ cj);
+    // Duplicate Morton codes (degenerate/duplicate centroids): break the tie
+    // using the sorted-order index, so the range/split binary searches below
+    // still see a strict order. This always compares greater than any
+    // genuine code mismatch (clz of a nonzero 32-bit value is <= 31),
+    // equivalent to Karras 2012's "append index as low bits of the key"
+    // treatment of duplicate keys.
+    return 32 + __clz((uint32_t)(i ^ j));
+}
+
+__global__ void karras_build_kernel(
+    const uint32_t* __restrict__ codes, int32_t n,
+    int32_t* __restrict__ left_child, int32_t* __restrict__ right_child,
+    int32_t* __restrict__ range_first, int32_t* __restrict__ range_last,
+    int32_t* __restrict__ parent_of_internal, int32_t* __restrict__ parent_of_leaf
+) {
+    int32_t i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n - 1) return;
+
+    int32_t d = (lbvh_delta(codes, n, i, i + 1) > lbvh_delta(codes, n, i, i - 1)) ? 1 : -1;
+
+    int32_t delta_min = lbvh_delta(codes, n, i, i - d);
+    int32_t lmax = 2;
+    while (lbvh_delta(codes, n, i, i + lmax * d) > delta_min) {
+        lmax <<= 1;
+    }
+
+    int32_t l = 0;
+    for (int32_t t = lmax >> 1; t >= 1; t >>= 1) {
+        if (lbvh_delta(codes, n, i, i + (l + t) * d) > delta_min) {
+            l += t;
+        }
+    }
+    int32_t j = i + l * d;
+
+    int32_t first = (i < j) ? i : j;
+    int32_t last = (i < j) ? j : i;
+    range_first[i] = first;
+    range_last[i] = last;
+
+    int32_t delta_node = lbvh_delta(codes, n, first, last);
+    int32_t split = first;
+    int32_t step = last - first;
+    do {
+        step = (step + 1) >> 1;
+        int32_t new_split = split + step;
+        if (new_split < last && lbvh_delta(codes, n, first, new_split) > delta_node) {
+            split = new_split;
+        }
+    } while (step > 1);
+
+    int32_t left, right;
+    if (split == first) {
+        left = -split - 1; // leaf
+        parent_of_leaf[split] = i;
+    } else {
+        left = split;
+        parent_of_internal[split] = i;
+    }
+    if (split + 1 == last) {
+        right = -(split + 1) - 1; // leaf
+        parent_of_leaf[split + 1] = i;
+    } else {
+        right = split + 1;
+        parent_of_internal[split + 1] = i;
+    }
+
+    left_child[i] = left;
+    right_child[i] = right;
+}
+
+// ---------------------------------------------------------------------------
+// Stage 4: bottom-up AABB refit + subtree-size/collapse decision, using the
+// classic atomic-flag "second thread finishes the node" technique (Karras'
+// NVIDIA blog "Thinking Parallel, Part III"; Apetrei 2014). One thread per
+// leaf climbs toward the root; at each internal node, the *second* thread to
+// arrive (i.e. the one that finds both children ready) computes that node's
+// bbox, decides whether its triangle range is small enough to collapse into
+// a single leaf in the final flat tree (<= n_primitives_per_leaf), and
+// records the flattened subtree size the top-down offset-assignment pass
+// (Stage 5) needs. __threadfence() precedes every completion signal
+// (atomicAdd) so the winning thread's view of its sibling's writes -- made
+// by whichever other thread finished that sibling -- is guaranteed visible.
+// ---------------------------------------------------------------------------
+
+__global__ void lbvh_refit_kernel(
+    int32_t n, const Triangle* __restrict__ triangles_sorted,
+    const int32_t* __restrict__ parent_of_leaf, const int32_t* __restrict__ parent_of_internal,
+    const int32_t* __restrict__ left_child, const int32_t* __restrict__ right_child,
+    const int32_t* __restrict__ range_first, const int32_t* __restrict__ range_last,
+    uint32_t n_primitives_per_leaf,
+    BoundingBox* __restrict__ bbox_internal, uint8_t* __restrict__ is_collapsed,
+    int32_t* __restrict__ flat_size, int32_t* __restrict__ atomic_flags
+) {
+    int32_t leaf = blockIdx.x * blockDim.x + threadIdx.x;
+    if (leaf >= n) return;
+
+    int32_t node = parent_of_leaf[leaf];
+    while (node != -1) {
+        __threadfence();
+        int32_t old = atomicAdd(&atomic_flags[node], 1);
+        if (old == 0) {
+            return; // sibling subtree not ready yet; that thread will finish this node.
+        }
+
+        int32_t a = left_child[node], b = right_child[node];
+        BoundingBox bbox_a = (a >= 0) ? bbox_internal[a] : BoundingBox(triangles_sorted[-a - 1]);
+        BoundingBox bbox_b = (b >= 0) ? bbox_internal[b] : BoundingBox(triangles_sorted[-b - 1]);
+        BoundingBox bbox = bbox_a;
+        bbox.enlarge(bbox_b);
+        bbox_internal[node] = bbox;
+
+        int32_t count = range_last[node] - range_first[node] + 1;
+        bool collapsed = count <= (int32_t)n_primitives_per_leaf;
+        is_collapsed[node] = collapsed ? 1 : 0;
+
+        if (collapsed) {
+            flat_size[node] = 1;
+        } else {
+            int32_t size_a = (a >= 0) ? (is_collapsed[a] ? 1 : flat_size[a]) : 1;
+            int32_t size_b = (b >= 0) ? (is_collapsed[b] ? 1 : flat_size[b]) : 1;
+            flat_size[node] = 1 + size_a + size_b;
+        }
+
+        node = parent_of_internal[node];
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Stage 5: top-down flatten into the final TriangleBvhNode array, processed
+// level by level (BFS). Each launch consumes the current frontier of
+// not-yet-expanded internal nodes (each already assigned a final array
+// index, an escape_idx and a *descendant region* by its parent's launch)
+// and, for each: writes its BoundingBox/escape_idx, places its 2 children in
+// the 2 CONTIGUOUS slots at the start of its descendant region
+// ([left_idx, left_idx+2), which is what TriangleBvhWithBranchingFactor<2>'s
+// stack traversal reads: bvhnodes[node.left_idx + i] for i in {0,1}), and
+// either writes each child directly (true singleton leaf, or a collapsed
+// internal node covering a contiguous triangle range) or enqueues it into
+// the next frontier for its own future expansion.
+//
+// Layout of a node v at final index f with descendant region starting at
+// base (region size = flat_size[v] - 1, i.e. every node of v's subtree
+// except v itself):
+//
+//     base      : child A            (left_idx  = base)
+//     base + 1  : child B            (right_idx = base + 2, exclusive end)
+//     base + 2  : A's descendant region, flat_size[A] - 1 slots
+//     ...       : B's descendant region, flat_size[B] - 1 slots
+//
+// Root: final index 0, descendant region starts at 1, escape_idx -1. This is
+// the same "children first, then the subtrees" layout the host builder's
+// number_and_flatten produces (only the relative order of the two
+// sub-regions differs, which the traversal never depends on).
+//
+// NOTE: a DFS pre-order layout (child B placed *after* child A's entire
+// subtree, right_final = left_final + flat_size[A]) would only be valid for the
+// stackless escape-link walk; the primary stack-based traversal in bvh.cu
+// (closest_triangle / ray_intersect / ...) reads the children contiguously,
+// so both children must be stored next to each other as above.
+//
+// Escape-link semantics mirror the host builder's thread_bvh exactly: a
+// node's first child escapes to its sibling's slot; the last child escapes
+// to the parent's own escape_idx. Root: final index 0, escape_idx -1.
+// ---------------------------------------------------------------------------
+
+__device__ __forceinline__ void lbvh_write_leaf(
+    TriangleBvhNode* __restrict__ out_nodes, int32_t final_idx, int32_t escape,
+    const BoundingBox& bb, int32_t range_begin, int32_t range_end_exclusive
+) {
+    out_nodes[final_idx].bb = bb;
+    out_nodes[final_idx].left_idx = -range_begin - 1;
+    out_nodes[final_idx].right_idx = -range_end_exclusive - 1;
+    out_nodes[final_idx].escape_idx = escape;
+}
+
+__global__ void lbvh_flatten_level_kernel(
+    int32_t frontier_count,
+    const int32_t* __restrict__ frontier_node, const int32_t* __restrict__ frontier_final_idx,
+    const int32_t* __restrict__ frontier_escape, const int32_t* __restrict__ frontier_desc_base,
+    const int32_t* __restrict__ left_child, const int32_t* __restrict__ right_child,
+    const int32_t* __restrict__ range_first, const int32_t* __restrict__ range_last,
+    const BoundingBox* __restrict__ bbox_internal, const uint8_t* __restrict__ is_collapsed, const int32_t* __restrict__ flat_size,
+    const Triangle* __restrict__ triangles_sorted,
+    TriangleBvhNode* __restrict__ out_nodes,
+    int32_t* __restrict__ next_frontier_node, int32_t* __restrict__ next_frontier_final_idx,
+    int32_t* __restrict__ next_frontier_escape, int32_t* __restrict__ next_frontier_desc_base,
+    int32_t* __restrict__ next_frontier_counter
+) {
+    int32_t t = blockIdx.x * blockDim.x + threadIdx.x;
+    if (t >= frontier_count) return;
+
+    int32_t node = frontier_node[t];
+    int32_t final_idx = frontier_final_idx[t];
+    int32_t escape = frontier_escape[t];
+    int32_t base = frontier_desc_base[t];
+
+    out_nodes[final_idx].bb = bbox_internal[node];
+    out_nodes[final_idx].escape_idx = escape;
+
+    int32_t a = left_child[node], b = right_child[node];
+    int32_t size_a = (a >= 0) ? (is_collapsed[a] ? 1 : flat_size[a]) : 1;
+
+    // Children are CONTIGUOUS: [base, base + 2). Their own descendant regions
+    // follow: A's at base + 2 (size_a - 1 slots), B's right after A's.
+    const int32_t left_final = base;
+    const int32_t right_final = base + 1;
+    const int32_t desc_base_a = base + 2;
+    const int32_t desc_base_b = desc_base_a + (size_a - 1);
+
+    out_nodes[final_idx].left_idx = left_final;
+    out_nodes[final_idx].right_idx = base + 2; // exclusive end of the children run
+
+    // Child A: first sibling, escapes to child B's slot.
+    if (a < 0) {
+        int32_t leaf_id = -a - 1;
+        lbvh_write_leaf(out_nodes, left_final, right_final, BoundingBox(triangles_sorted[leaf_id]), leaf_id, leaf_id + 1);
+    } else if (is_collapsed[a]) {
+        lbvh_write_leaf(out_nodes, left_final, right_final, bbox_internal[a], range_first[a], range_last[a] + 1);
+    } else {
+        int32_t slot = atomicAdd(next_frontier_counter, 1);
+        next_frontier_node[slot] = a;
+        next_frontier_final_idx[slot] = left_final;
+        next_frontier_escape[slot] = right_final;
+        next_frontier_desc_base[slot] = desc_base_a;
+    }
+
+    // Child B: last sibling, escapes to this node's own escape_idx.
+    if (b < 0) {
+        int32_t leaf_id = -b - 1;
+        lbvh_write_leaf(out_nodes, right_final, escape, BoundingBox(triangles_sorted[leaf_id]), leaf_id, leaf_id + 1);
+    } else if (is_collapsed[b]) {
+        lbvh_write_leaf(out_nodes, right_final, escape, bbox_internal[b], range_first[b], range_last[b] + 1);
+    } else {
+        int32_t slot = atomicAdd(next_frontier_counter, 1);
+        next_frontier_node[slot] = b;
+        next_frontier_final_idx[slot] = right_final;
+        next_frontier_escape[slot] = escape;
+        next_frontier_desc_base[slot] = desc_base_b;
+    }
+}
+
+} // namespace
+
+void build_lbvh_device(
+    GPUMemory<Triangle>& triangles_gpu,
+    GPUMemory<TriangleBvhNode>& nodes_gpu,
+    uint32_t n_primitives_per_leaf,
+    cudaStream_t stream
+) {
+    const int32_t n = (int32_t)triangles_gpu.size();
+    if (n <= (int32_t)n_primitives_per_leaf) {
+        throw std::runtime_error("build_lbvh_device: need more triangles than n_primitives_per_leaf");
+    }
+
+    // --- scene (centroid) AABB ------------------------------------------------
+    const uint32_t reduce_blocks = std::min<uint32_t>(n_blocks((uint32_t)n), 4096u);
+    GPUMemory<Eigen::Vector3f> partial_min(reduce_blocks), partial_max(reduce_blocks);
+    GPUMemory<Eigen::Vector3f> scene_min(1), scene_max(1);
+    centroid_partial_reduce_kernel<<<reduce_blocks, kThreads, 0, stream>>>(
+        (uint32_t)n, triangles_gpu.data(), partial_min.data(), partial_max.data());
+    centroid_final_reduce_kernel<<<1, kThreads, 0, stream>>>(
+        reduce_blocks, partial_min.data(), partial_max.data(), scene_min.data(), scene_max.data());
+
+    // --- Morton codes + index array -------------------------------------------
+    GPUMemory<uint32_t> codes_in(n), indices_in(n);
+    morton_code_kernel<<<n_blocks((uint32_t)n), kThreads, 0, stream>>>(
+        (uint32_t)n, triangles_gpu.data(), scene_min.data(), scene_max.data(), codes_in.data(), indices_in.data());
+
+    // --- sort primitives by Morton code (restricted to the 30 significant bits) ---
+    GPUMemory<uint32_t> codes_out(n), indices_out(n);
+    size_t temp_bytes = 0;
+    LBVH_CUDA_CHECK(cub::DeviceRadixSort::SortPairs(
+        nullptr, temp_bytes, codes_in.data(), codes_out.data(), indices_in.data(), indices_out.data(),
+        n, 0, 30, stream));
+    GPUMemory<uint8_t> temp_storage(temp_bytes);
+    LBVH_CUDA_CHECK(cub::DeviceRadixSort::SortPairs(
+        temp_storage.data(), temp_bytes, codes_in.data(), codes_out.data(), indices_in.data(), indices_out.data(),
+        n, 0, 30, stream));
+
+    // --- reorder triangles into Morton order (leaf ranges index into this array) ---
+    GPUMemory<Triangle> triangles_sorted(n);
+    gather_by_permutation_kernel<<<n_blocks((uint32_t)n), kThreads, 0, stream>>>(
+        (uint32_t)n, triangles_gpu.data(), indices_out.data(), triangles_sorted.data());
+
+    // --- Karras binary radix-tree hierarchy -----------------------------------
+    const int32_t n_internal = n - 1;
+    GPUMemory<int32_t> left_child(n_internal), right_child(n_internal);
+    GPUMemory<int32_t> range_first(n_internal), range_last(n_internal);
+    GPUMemory<int32_t> parent_of_internal(n_internal), parent_of_leaf(n);
+    LBVH_CUDA_CHECK(cudaMemsetAsync(parent_of_internal.data(), 0xFF, n_internal * sizeof(int32_t), stream));
+    LBVH_CUDA_CHECK(cudaMemsetAsync(parent_of_leaf.data(), 0xFF, n * sizeof(int32_t), stream));
+    karras_build_kernel<<<n_blocks((uint32_t)n_internal), kThreads, 0, stream>>>(
+        codes_out.data(), n, left_child.data(), right_child.data(),
+        range_first.data(), range_last.data(), parent_of_internal.data(), parent_of_leaf.data());
+
+    // --- bottom-up refit + collapse decision -----------------------------------
+    GPUMemory<BoundingBox> bbox_internal(n_internal);
+    GPUMemory<uint8_t> is_collapsed(n_internal);
+    GPUMemory<int32_t> flat_size(n_internal);
+    GPUMemory<int32_t> atomic_flags(n_internal);
+    LBVH_CUDA_CHECK(cudaMemsetAsync(atomic_flags.data(), 0, n_internal * sizeof(int32_t), stream));
+    LBVH_CUDA_CHECK(cudaMemsetAsync(is_collapsed.data(), 0, n_internal * sizeof(uint8_t), stream));
+    lbvh_refit_kernel<<<n_blocks((uint32_t)n), kThreads, 0, stream>>>(
+        n, triangles_sorted.data(), parent_of_leaf.data(), parent_of_internal.data(),
+        left_child.data(), right_child.data(), range_first.data(), range_last.data(),
+        n_primitives_per_leaf, bbox_internal.data(), is_collapsed.data(), flat_size.data(), atomic_flags.data());
+
+    uint8_t root_collapsed_h = 0;
+    int32_t root_flat_size_h = 1;
+    LBVH_CUDA_CHECK(cudaMemcpyAsync(&root_collapsed_h, is_collapsed.data(), sizeof(uint8_t), cudaMemcpyDeviceToHost, stream));
+    LBVH_CUDA_CHECK(cudaMemcpyAsync(&root_flat_size_h, flat_size.data(), sizeof(int32_t), cudaMemcpyDeviceToHost, stream));
+    LBVH_CUDA_CHECK(cudaStreamSynchronize(stream));
+    if (root_collapsed_h) {
+        // Cannot happen given the n > n_primitives_per_leaf guard above (root's range
+        // always spans all n triangles), but guard defensively rather than silently
+        // emitting a degenerate 1-node tree.
+        throw std::runtime_error("build_lbvh_device: root collapsed unexpectedly");
+    }
+    const int32_t total_nodes = root_flat_size_h;
+
+    // --- top-down flatten (BFS by level) ----------------------------------------
+    nodes_gpu.resize((size_t)total_nodes);
+
+    GPUMemory<int32_t> frontier_node(total_nodes), frontier_final_idx(total_nodes), frontier_escape(total_nodes), frontier_desc_base(total_nodes);
+    GPUMemory<int32_t> next_frontier_node(total_nodes), next_frontier_final_idx(total_nodes), next_frontier_escape(total_nodes), next_frontier_desc_base(total_nodes);
+    GPUMemory<int32_t> frontier_counter(1);
+
+    // Root: final index 0, escape -1, its descendants occupy [1, total_nodes).
+    const int32_t root_seed_node = 0, root_seed_final = 0, root_seed_escape = -1, root_seed_desc_base = 1;
+    LBVH_CUDA_CHECK(cudaMemcpyAsync(frontier_node.data(), &root_seed_node, sizeof(int32_t), cudaMemcpyHostToDevice, stream));
+    LBVH_CUDA_CHECK(cudaMemcpyAsync(frontier_final_idx.data(), &root_seed_final, sizeof(int32_t), cudaMemcpyHostToDevice, stream));
+    LBVH_CUDA_CHECK(cudaMemcpyAsync(frontier_escape.data(), &root_seed_escape, sizeof(int32_t), cudaMemcpyHostToDevice, stream));
+    LBVH_CUDA_CHECK(cudaMemcpyAsync(frontier_desc_base.data(), &root_seed_desc_base, sizeof(int32_t), cudaMemcpyHostToDevice, stream));
+
+    int32_t frontier_count = 1;
+    const int32_t kMaxLevels = 64; // generous bound; balanced tree depth is ~log2(n) << this.
+    int32_t level = 0;
+    for (; level < kMaxLevels && frontier_count > 0; ++level) {
+        LBVH_CUDA_CHECK(cudaMemsetAsync(frontier_counter.data(), 0, sizeof(int32_t), stream));
+        lbvh_flatten_level_kernel<<<n_blocks((uint32_t)frontier_count), kThreads, 0, stream>>>(
+            frontier_count,
+            frontier_node.data(), frontier_final_idx.data(), frontier_escape.data(), frontier_desc_base.data(),
+            left_child.data(), right_child.data(), range_first.data(), range_last.data(),
+            bbox_internal.data(), is_collapsed.data(), flat_size.data(),
+            triangles_sorted.data(), nodes_gpu.data(),
+            next_frontier_node.data(), next_frontier_final_idx.data(), next_frontier_escape.data(), next_frontier_desc_base.data(),
+            frontier_counter.data());
+        int32_t next_count = 0;
+        LBVH_CUDA_CHECK(cudaMemcpyAsync(&next_count, frontier_counter.data(), sizeof(int32_t), cudaMemcpyDeviceToHost, stream));
+        LBVH_CUDA_CHECK(cudaStreamSynchronize(stream));
+        std::swap(frontier_node, next_frontier_node);
+        std::swap(frontier_final_idx, next_frontier_final_idx);
+        std::swap(frontier_escape, next_frontier_escape);
+        std::swap(frontier_desc_base, next_frontier_desc_base);
+        frontier_count = next_count;
+    }
+    if (frontier_count > 0) {
+        throw std::runtime_error("build_lbvh_device: flatten BFS exceeded max depth");
+    }
+
+    triangles_gpu = std::move(triangles_sorted);
+}
+
+} // namespace cubvh
+} // namespace fastpixal3d_cubvh_ns
