         try {
-            CUDA_CHECK_THROW(cudaMemcpy(data(), host_data, num_elements * sizeof(T), cudaMemcpyHostToDevice));
+            const size_t n_bytes = num_elements * sizeof(T);
+            if (n_bytes == 0) {
+                return;
+            }
+
+            // Stage through pinned host memory instead of the default synchronous
+            // pageable-memory cudaMemcpy: allocate one cudaHostAlloc buffer sized to
+            // the whole transfer, fill it with a single host-side memcpy, then issue
+            // it to the device as a sequence of <=256 MiB cudaMemcpyAsync chunks on
+            // the CURRENT PyTorch CUDA stream (at::cuda::getCurrentCUDAStream() --
+            // matching every other CUDA call in this file: ray_trace/unsigned_distance/
+            // signed_distance/sparse_marching_cubes all use it; this function used to
+            // hardcode the LEGACY DEFAULT STREAM (0) instead, which -- unlike every
+            // other stream in this codebase -- implicitly participates in cross-stream
+            // synchronization with any other work queued on the same device, a real
+            // divergence from the rest of the file's stream discipline when this
+            // upload runs concurrently with other CUDA work on other threads/streams
+            // (e.g. a texture-sampling stream running concurrently with mesh
+            // preparation). Followed by ONE cudaStreamSynchronize on
+            // that same stream. This produces bit-identical device contents to the
+            // plain cudaMemcpy fallback below; it exists only to avoid the CUDA
+            // driver's slower pageable-memory H2D path (about 1 GB/s on the machines we tried) on
+            // large uploads (cuBVH triangles/nodes).
+            //
+            // The pinned buffer is owned by a local RAII guard (PinnedHostGuard) so it
+            // is freed exactly once on every exit path -- including an exception
+            // thrown mid-copy -- via a destructor that only ever calls cudaFreeHost
+            // and discards its result (a destructor must never throw: there is nothing
+            // actionable to do here with a free failure, and even a "sticky"/fatal CUDA
+            // error from an earlier failed call makes cudaFreeHost return an error
+            // code, not throw, so this remains safe to call unconditionally).
+            void* raw_pinned = nullptr;
+            cudaError_t alloc_err = cudaHostAlloc(&raw_pinned, n_bytes, cudaHostAllocPortable);
+            if (alloc_err != cudaSuccess) {
+                cudaGetLastError(); // clear the sticky error before falling back
+                CUDA_CHECK_THROW(cudaMemcpy(data(), host_data, n_bytes, cudaMemcpyHostToDevice));
+                return;
+            }
+
+            struct PinnedHostGuard {
+                void* ptr;
+                ~PinnedHostGuard() noexcept {
+                    if (ptr) {
+                        cudaFreeHost(ptr);
+                    }
+                }
+            } guard{raw_pinned};
+            uint8_t* pinned = (uint8_t*)raw_pinned;
+
+            std::memcpy(pinned, host_data, n_bytes);
+
+            cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+            constexpr size_t kChunkBytes = size_t{256} << 20; // 256 MiB
+            uint8_t* dst = (uint8_t*)data();
+            for (size_t offset = 0; offset < n_bytes; offset += kChunkBytes) {
+                const size_t this_chunk = std::min(kChunkBytes, n_bytes - offset);
+                CUDA_CHECK_THROW(cudaMemcpyAsync(dst + offset, pinned + offset, this_chunk, cudaMemcpyHostToDevice, stream));
+            }
+            CUDA_CHECK_THROW(cudaStreamSynchronize(stream));
+            // `guard` frees the pinned buffer here on normal return, or while
+            // unwinding to the catch below if a CUDA_CHECK_THROW above threw.
         } catch (std::runtime_error error) {
             throw std::runtime_error(std::string("Could not copy from host: ") + error.what());
         }
diff --git a/include/gpu/lbvh_build.cuh b/include/gpu/lbvh_build.cuh
new file mode 100644
index 0000000..cc32e88
--- /dev/null
+++ b/include/gpu/lbvh_build.cuh
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <gpu/common.h>
+#include <gpu/triangle.cuh>
+#include <gpu/bvh.cuh>
+#include <gpu/gpu_memory.h>
+
+namespace fastpixal3d_cubvh_ns {
+namespace cubvh {
+
+// Builds a binary LBVH (Karras 2012) entirely on the GPU: computes triangle
+// centroids/AABBs, 30-bit Morton codes over the scene (centroid) AABB, sorts
+// primitives by Morton code (cub::DeviceRadixSort), constructs the binary
+// radix-tree hierarchy via longest-common-prefix ranges, refits AABBs
+// bottom-up with atomic counters, collapses subtrees whose triangle range is
+// <= n_primitives_per_leaf into a single leaf, and flattens the result into
+// the same TriangleBvhNode layout used by the existing query traversal
+// (bvh.cu), instantiated here with BRANCHING_FACTOR=2: every internal node's
+// two children sit contiguously at [left_idx, left_idx+2).
+//
+// `triangles_gpu` holds n_triangles Triangle structs on entry (any order) and
+// is replaced in place with the Morton-sorted array (leaf triangle ranges in
+// the resulting nodes index into this reordered array; each Triangle's `id`
+// field is untouched by the reorder, so it always reflects the *original*
+// face index regardless of position -- matching the host builder's
+// behavior). `nodes_gpu` is (re)sized to the final node count and filled.
+//
+// No host-side per-node work: the only host<->device synchronization points
+// are (a) one tiny readback of the root's collapse flag + final node count
+// after the bottom-up refit, and (b) one readback of the next BFS frontier's
+// size per tree level (~O(log n) levels) while flattening.
+void build_lbvh_device(
+    GPUMemory<Triangle>& triangles_gpu,
+    GPUMemory<TriangleBvhNode>& nodes_gpu,
+    uint32_t n_primitives_per_leaf,
+    cudaStream_t stream
+);
+
+} // namespace cubvh
+} // namespace fastpixal3d_cubvh_ns
