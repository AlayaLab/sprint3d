+template<typename T>
+__global__ void af_index_kernel(const T* values, const int* indices, const int N, const int* d_skip, T* output) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= N) return;
+    if (d_skip != nullptr && *d_skip) return;
+    output[tid] = values[indices[tid]];
+}
