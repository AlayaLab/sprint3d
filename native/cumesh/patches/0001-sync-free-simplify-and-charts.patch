+
+__global__ void af_hook_edges_if_same_chart_kernel(
+    const int2* adj,
+    const int* chart_ids,
+    const int M,
+    int* conn_comp_ids,
+    int* st
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= M) return;
+    if (st[CS_UF_DONE]) return;
+
+    // get adjacent faces
+    int f0 = adj[tid].x;
+    int f1 = adj[tid].y;
+    int c0 = chart_ids[f0];
+    int c1 = chart_ids[f1];
+    if (c0 != c1) return;
+
+    // union
+    // find roots
+    int root0 = conn_comp_ids[f0];
+    while (root0 != conn_comp_ids[root0]) {
+        root0 = conn_comp_ids[root0];
+    }
+    int root1 = conn_comp_ids[f1];
+    while (root1 != conn_comp_ids[root1]) {
+        root1 = conn_comp_ids[root1];
+    }
+
+    if (root0 == root1) return;
+
+    int high = max(root0, root1);
+    int low = min(root0, root1);
+    atomicMin(&conn_comp_ids[high], low);
+    st[CS_UF_END] = 0;
+}
+
+
+__global__ void af_compress_components_kernel(int* conn_comp_ids, const int F, const int* st) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= F) return;
+    if (st[CS_UF_DONE]) return;
+
+    int p = conn_comp_ids[tid];
+    while (p != conn_comp_ids[p]) {
+        p = conn_comp_ids[p];
+    }
+    conn_comp_ids[tid] = p;
+}
