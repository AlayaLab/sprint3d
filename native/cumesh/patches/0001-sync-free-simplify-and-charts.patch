+
+std::vector<int> CuMesh::compute_charts_sync_free(
+    float threshold_cone_half_angle_rad,
+    int refine_iterations,
+    int global_iterations,
+    float smooth_strength,
+    float area_penalty_weight,
+    float perimeter_area_ratio_weight,
+    int max_rounds,
+    int sync_every,
+    int max_uf_passes,
+    bool compact_chart_bits,
+    bool skip_collapse_cone_writeback,
+    bool fuse_round_kernels
+) {
+    cudaStream_t stream = current_stream();
+    TORCH_CHECK(max_rounds > 0, "[CuMesh] compute_charts_sync_free: max_rounds must be positive");
+    TORCH_CHECK(max_uf_passes > 0, "[CuMesh] compute_charts_sync_free: max_uf_passes must be positive");
+    TORCH_CHECK(sync_every >= 0, "[CuMesh] compute_charts_sync_free: sync_every must be >= 0");
+
+    // Same preconditions as the original (these helpers have their own
+    // host syncs; they run once, identically, in both paths).
+    if (this->manifold_face_adj.is_empty()) {
+        this->get_manifold_face_adjacency();
+    }
+    if (this->face_normals.is_empty()) {
+        this->compute_face_normals();
+    }
+    if (this->face_areas.is_empty()) {
+        this->compute_face_areas();
+    }
+
+    ChartsCtx c;
+    c.det = this->deterministic;
+    c.F = static_cast<int>(this->faces.size);
+    c.M = static_cast<int>(this->manifold_face_adj.size);
+    c.C0 = c.F;
+    // CO1-CO3 (see this function's own header comment for the full
+    // per-option writeup): all default to the plain sync-free behaviour.
+    c.compact_chart_bits = compact_chart_bits;
+    // key_shift/pair_end_bit pack the chart_adj (min_chart,max_chart) sort
+    // key -- disabled whenever deterministic (det_expand_chart_keys_kernel,
+    // shared unmodified with atlas.cu, assumes the fixed encoding).
+    c.key_shift = (compact_chart_bits && !c.det) ? af_bits_needed(c.C0) : 32;
+    c.key_mask = (c.key_shift >= 32) ? uint64_t(0xFFFFFFFFu) : ((uint64_t(1) << c.key_shift) - 1);
+    c.pair_end_bit = (compact_chart_bits && !c.det) ? 2 * c.key_shift : int(sizeof(uint64_t) * 8);
+    // plain_end_bit narrows the two plain-int sorts (face-by-chart-id in
+    // af_compute_chart_normal_cones, af_compress_ids' internal sort) --
+    // unconditional on determinism (unrelated to the chart_adj pair
+    // encoding: every value sorted is a real chart id in [0, C0), no
+    // sentinel padding, see header "CO1").
+    c.plain_end_bit = compact_chart_bits ? af_bits_needed(c.C0) : int(sizeof(int) * 8);
+    c.skip_cone_writeback = skip_collapse_cone_writeback;
+    c.fuse_round_kernels = fuse_round_kernels;
+    c.grid_F = (c.F + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    c.grid_M = (c.M + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    c.grid_C0 = (c.C0 + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    c.grid_C0p1 = (c.C0 + 1 + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    if (c.grid_M < 1) c.grid_M = 1;
+
+    // Initialize chart ids (same as original)
+    const size_t F = this->faces.size;
+    this->atlas_chart_ids.resize(F);
+    this->atlas_num_charts = static_cast<int>(F);
+    arange_kernel<<<c.grid_F, BLOCK_SIZE, 0, stream>>>(this->atlas_chart_ids.ptr, F);
+    CUDA_CHECK(cudaGetLastError());
+    this->temp_storage.resize(F * sizeof(int));  // ping-pong buffer for refine / union-find parents
+
+    // Scratch arena: dry-run carve to size, one cudaMalloc, real carve.
+    // The cub temp-storage query needs (any) pointers of the right types; the
+    // dry-run nullptrs are fine for size queries.
+    Arena arena;
+    arena.dry_run = true;
+    c.cub_temp_bytes = 0;
+    c.carve(arena, global_iterations);
+    c.cub_temp_bytes = af_query_cub_temp(c, stream);
+    arena.offset = 0;
+    c.carve(arena, global_iterations);
+    const size_t total_bytes = arena.offset;
+    CUDA_CHECK(cudaMalloc(&arena.base, total_bytes));
+    arena.dry_run = false;
+    arena.offset = 0;
+    c.carve(arena, global_iterations);
+
+    CUDA_CHECK(cudaMemsetAsync(c.st, 0, c.num_state * sizeof(int), stream));
+    {
+        // CS_C = F
+        af_fill_int_kernel<<<1, 1, 0, stream>>>(c.st + CS_C, 1, c.F, nullptr);
+        CUDA_CHECK(cudaGetLastError());
+    }
+
+    std::vector<int> h_state(c.num_state, 0);
+    bool cap_error = false;
+    std::string cap_msg;
+
+    for (int i = 0; i < global_iterations && !cap_error; i++) {
+        af_global_iter_begin_kernel<<<1, 1, 0, stream>>>(c.st);
+        CUDA_CHECK(cudaGetLastError());
+
+        // --- collapse loop (H5) ---
+        for (int r = 0; r < max_rounds; r++) {
+            af_collapse_round(*this, c, threshold_cone_half_angle_rad, area_penalty_weight, perimeter_area_ratio_weight, stream);
+            if (sync_every > 0 && ((r + 1) % sync_every == 0) && (r + 1) < max_rounds) {
+                int h_done = 0;
+                CUDA_CHECK(cudaMemcpyAsync(&h_done, c.st + CS_WHILE_DONE, sizeof(int), cudaMemcpyDeviceToHost, stream));
+                CUDA_CHECK(cudaStreamSynchronize(stream));
+                if (h_done) break;
+            }
+        }
+
+        // --- refine (fixed host count, no decision) ---
+        for (int j = 0; j < refine_iterations; j++) {
+            af_compute_chart_normal_cones(*this, c, nullptr, stream);
+            af_refine_charts_kernel<<<c.grid_F, BLOCK_SIZE, 0, stream>>>(
+                c.cones,
+                this->face_normals.ptr,
+                this->vertices.ptr,
+                this->edges.ptr,
+                this->face2edge.ptr,
+                this->edge2face.ptr,
+                this->edge2face_offset.ptr,
+                F,
+                smooth_strength,
+                this->atlas_chart_ids.ptr,
+                reinterpret_cast<int*>(this->temp_storage.ptr));
+            CUDA_CHECK(cudaGetLastError());
+            swap_buffers(this->atlas_chart_ids, this->temp_storage);
+            af_compress_ids(c, this->atlas_chart_ids.ptr, c.F, nullptr, c.st + CS_C, nullptr, stream);
+        }
+
+        // --- reassign chart ids (H8) ---
+        arange_kernel<<<c.grid_F, BLOCK_SIZE, 0, stream>>>(reinterpret_cast<int*>(this->temp_storage.ptr), F);
+        CUDA_CHECK(cudaGetLastError());
+        for (int p = 0; p < max_uf_passes; p++) {
+            af_uf_begin_kernel<<<1, 1, 0, stream>>>(c.st);
+            af_hook_edges_if_same_chart_kernel<<<c.grid_M, BLOCK_SIZE, 0, stream>>>(
+                this->manifold_face_adj.ptr, this->atlas_chart_ids.ptr, c.M,
+                reinterpret_cast<int*>(this->temp_storage.ptr), c.st);
+            CUDA_CHECK(cudaGetLastError());
+            af_compress_components_kernel<<<c.grid_F, BLOCK_SIZE, 0, stream>>>(
+                reinterpret_cast<int*>(this->temp_storage.ptr), c.F, c.st);
+            CUDA_CHECK(cudaGetLastError());
+            af_uf_decide_kernel<<<1, 1, 0, stream>>>(c.st);
+            CUDA_CHECK(cudaGetLastError());
+        }
+        swap_buffers(this->atlas_chart_ids, this->temp_storage);
+        af_compress_ids(c, this->atlas_chart_ids.ptr, c.F, nullptr, c.st + CS_C, nullptr, stream);
+
+        af_global_iter_record_kernel<<<1, 1, 0, stream>>>(c.st, i);
+        CUDA_CHECK(cudaGetLastError());
+    }
+
+    // H10: the single readback.
+    CUDA_CHECK(cudaMemcpyAsync(h_state.data(), c.st, c.num_state * sizeof(int), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    CUDA_CHECK(cudaFree(arena.base));
+
+    std::vector<int> stats(h_state.begin() + CS_SIZE, h_state.end());
+    for (int i = 0; i < global_iterations; i++) {
+        if (stats[CS_STATS_STRIDE * i + 1] != 1) {
+            TORCH_CHECK(false, "[CuMesh] compute_charts_sync_free: max_rounds=", max_rounds,
+                        " reached before the collapse loop converged in global iteration ", i,
+                        " (rounds executed=", stats[CS_STATS_STRIDE * i + 0], "); increase max_rounds "
+                        "(the caller may fall back to compute_charts(sync_free=False)).");
+        }
+        if (stats[CS_STATS_STRIDE * i + 3] != 1) {
+            TORCH_CHECK(false, "[CuMesh] compute_charts_sync_free: max_uf_passes=", max_uf_passes,
+                        " reached before the union-find converged in global iteration ", i,
+                        "; increase max_uf_passes (the caller may fall back to compute_charts(sync_free=False)).");
+        }
+    }
+
+    this->atlas_num_charts = h_state[CS_C];
+
+    // Finalizing: calculate vmap, chart face and chart face offset (original, host-synced, once)
+    construct_chart_mesh(*this, stream);
+
+    return stats;
+}
+
+
+} // namespace fastpixal3d_cumesh_ns
