+
+// CO3: af_index_kernel<float> (areas) + af_index_kernel<float3> (normals)
+// fused into one launch -- same `indices` permutation, same N, independent
+// destinations; purely mechanical (two gathers done by one thread instead
+// of two kernels' worth of threads), no value changes.
+__global__ void af_gather_area_normal_kernel(
+    const float* face_areas, const float3* face_normals, const int* indices, const int N,
+    const int* d_skip, float* sorted_areas, float3* sorted_normals
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= N) return;
+    if (d_skip != nullptr && *d_skip) return;
+    int idx = indices[tid];
+    sorted_areas[tid] = face_areas[idx];
+    sorted_normals[tid] = face_normals[idx];
+}
+
+
+// CO3: arange_kernel(faces_ids, F) + af_fill_int_kernel(chart_offsets, C0+1,
+// F) fused into one launch -- independent arrays/domains (C0 == F always,
+// see compute_charts_sync_free), no data dependency between them; purely
+// mechanical. Unconditional (no d_skip check) on both halves: arange_kernel
+// never had one (shared.h), and af_fill_int_kernel's own skip-gate was pure
+// wasted-work avoidance with no consumer-visible effect (both writes are
+// idempotent -- the same deterministic content every call -- and nothing
+// downstream ever reads either array in a round where the fill would have
+// been skipped, since every consumer is itself skip-gated); this simply
+// runs those two idempotent writes unconditionally, marginally undoing part
+// of the no-op-round savings the skip-gate was providing (bounded by
+// sync_every-1 wasted rounds) in exchange for one fewer launch every real
+// round.
+__global__ void af_init_cones_prep_kernel(int* faces_ids, const int F, int* chart_offsets, const int C0p1, const int fill_value) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid < F) faces_ids[tid] = tid;
+    if (tid < C0p1) chart_offsets[tid] = fill_value;
+}
