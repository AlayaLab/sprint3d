+
+#if CUDART_VERSION >= 12090
+inline auto af_reduce_op() { return ::cuda::std::plus(); }
+#else
+inline auto af_reduce_op() { return cub::Sum(); }
+#endif
+
+
+// CO1: pair_end_bit/plain_end_bit are the actual bit ranges the runtime
+// sort calls will use (64/32 unless compact_chart_bits) -- sized for those
+// ranges so the arena's cub_temp is never under-allocated for a narrower
+// (equal-or-smaller-temp) sort. The plain_end_bit query below (N=c.F,
+// int/int SortPairs) also covers af_compute_chart_normal_cones' face-by-
+// chart-id sort: same N, same KeyT/ValueT, same bit range -> CUB's temp
+// size depends only on those, not the specific pointers.
+size_t af_query_cub_temp(ChartsCtx& c, cudaStream_t stream) {
+    size_t bytes = 0, max_bytes = 0;
+    bytes = 0;
+    CUDA_CHECK(cub::DeviceRadixSort::SortPairs(
+        nullptr, bytes, c.chart_adj, c.sorted_keys, c.raw_lengths, c.sorted_lengths,
+        c.M, 0, c.pair_end_bit, stream));
+    max_bytes = std::max(max_bytes, bytes);
+    bytes = 0;
+    CUDA_CHECK(cub::DeviceReduce::ReduceByKey(
+        nullptr, bytes, c.sorted_keys, c.chart_adj, c.sorted_lengths, c.chart_adj_length,
+        c.st + CS_NUM_RUNS, af_reduce_op(), c.M, stream));
+    max_bytes = std::max(max_bytes, bytes);
+    bytes = 0;
+    CUDA_CHECK(cub::DeviceScan::ExclusiveSum(
+        nullptr, bytes, c.chart2edge_cnt, c.chart2edge_offset, c.C0 + 1, stream));
+    max_bytes = std::max(max_bytes, bytes);
+    bytes = 0;
+    CUDA_CHECK(cub::DeviceRadixSort::SortPairs(
+        nullptr, bytes, c.cmp_indices, c.cmp_sorted, c.cmp_indices, c.cmp_argsorted,
+        c.F, 0, c.plain_end_bit, stream));
+    max_bytes = std::max(max_bytes, bytes);
+    bytes = 0;
+    CUDA_CHECK(cub::DeviceScan::ExclusiveSum(nullptr, bytes, c.cmp_flags, c.F, stream));
+    max_bytes = std::max(max_bytes, bytes);
+    if (c.det) {
+        bytes = 0;
+        CUDA_CHECK(cub::DeviceScan::ExclusiveSum(nullptr, bytes, c.det_flags, c.det_run_index, c.M, stream));
+        max_bytes = std::max(max_bytes, bytes);
+        bytes = 0;
+        CUDA_CHECK(cub::DeviceRadixSort::SortPairs(
+            nullptr, bytes, c.det_keys2, c.det_sorted_keys2, c.det_vals2, c.chart2edge,
+            2 * c.M, 0, sizeof(int) * 8, stream));
+        max_bytes = std::max(max_bytes, bytes);
+    }
+    return max_bytes;
+}
+
+
+// compute_chart_normal_cones, sync-free (H4). Reads mesh.atlas_chart_ids
+// (F ints) and CS_C; writes c.cones / c.chart_areas for charts [0, C).
+void af_compute_chart_normal_cones(CuMesh& mesh, ChartsCtx& c, const int* d_skip, cudaStream_t stream) {
+    const int F = c.F;
+    // 1. Sort faces by chart id (identical call to the original, CO1: end_bit
+    // narrowed to c.plain_end_bit instead of the fixed 32 when compact_chart_bits)
+    if (c.fuse_round_kernels) {
+        af_init_cones_prep_kernel<<<c.grid_C0p1, BLOCK_SIZE, 0, stream>>>(
+            c.faces_ids, F, c.chart_offsets, c.C0 + 1, F);
+        CUDA_CHECK(cudaGetLastError());
+    } else {
+        arange_kernel<<<c.grid_F, BLOCK_SIZE, 0, stream>>>(c.faces_ids, F);
+        CUDA_CHECK(cudaGetLastError());
+    }
+    {
+        size_t bytes = c.cub_temp_bytes;
+        CUDA_CHECK(cub::DeviceRadixSort::SortPairs(
+            c.cub_temp, bytes,
+            mesh.atlas_chart_ids.ptr, c.sorted_chart_ids,
+            c.faces_ids, c.argsorted_faces_ids,
+            F, 0, c.plain_end_bit, stream));
+    }
+    // 2. Segment offsets (replaces RLE + ExclusiveSum over a host-sized C+1)
+    if (!c.fuse_round_kernels) {
+        af_fill_int_kernel<<<c.grid_C0p1, BLOCK_SIZE, 0, stream>>>(c.chart_offsets, c.C0 + 1, F, d_skip);
+        CUDA_CHECK(cudaGetLastError());
+    }
+    af_segment_starts_kernel<<<c.grid_F, BLOCK_SIZE, 0, stream>>>(c.sorted_chart_ids, F, d_skip, c.chart_offsets);
+    CUDA_CHECK(cudaGetLastError());
+    // 3. Chart areas and normals (CO3: gathers fused into one launch)
+    if (c.fuse_round_kernels) {
+        af_gather_area_normal_kernel<<<c.grid_F, BLOCK_SIZE, 0, stream>>>(
+            mesh.face_areas.ptr, mesh.face_normals.ptr, c.argsorted_faces_ids, F, d_skip,
+            c.sorted_face_areas, c.sorted_face_normals);
+        CUDA_CHECK(cudaGetLastError());
+    } else {
+        af_index_kernel<float><<<c.grid_F, BLOCK_SIZE, 0, stream>>>(
+            mesh.face_areas.ptr, c.argsorted_faces_ids, F, d_skip, c.sorted_face_areas);
+        CUDA_CHECK(cudaGetLastError());
+        af_index_kernel<float3><<<c.grid_F, BLOCK_SIZE, 0, stream>>>(
+            mesh.face_normals.ptr, c.argsorted_faces_ids, F, d_skip, c.sorted_face_normals);
+        CUDA_CHECK(cudaGetLastError());
+    }
+    af_segmented_reduce<float, float, cub::Sum, float>(
+        c.sorted_face_areas, c.chart_areas, c.chart_offsets, c.chart_offsets + 1,
+        c.st + CS_C, d_skip, c.C0, cub::Sum(), float(), stream);
+
+    af_segmented_reduce<float3, float3, AfFloat3Add, float3>(
+        c.sorted_face_normals, c.chart_normals, c.chart_offsets, c.chart_offsets + 1,
+        c.st + CS_C, d_skip, c.C0, AfFloat3Add(), make_float3(0.0f, 0.0f, 0.0f), stream);
+    af_normalize_kernel<<<c.grid_C0, BLOCK_SIZE, 0, stream>>>(c.chart_normals, c.st + CS_C, c.C0, d_skip);
+    CUDA_CHECK(cudaGetLastError());
+
+    // 4. Normal difference
+    af_normal_diff_kernel<<<c.grid_F, BLOCK_SIZE, 0, stream>>>(
+        c.chart_normals, c.sorted_face_normals, c.sorted_chart_ids, F, d_skip, c.normal_diff);
+    CUDA_CHECK(cudaGetLastError());
+
+    // 5. New cone half angles
+    af_segmented_reduce<float, float, cub::Max, float>(
+        c.normal_diff, c.half_angles, c.chart_offsets, c.chart_offsets + 1,
+        c.st + CS_C, d_skip, c.C0, cub::Max(), cub::Traits<float>::Lowest(), stream);
+
+    // 6. Update chart normal cones
+    af_update_normal_cones_kernel<<<c.grid_C0, BLOCK_SIZE, 0, stream>>>(
+        c.cones, c.chart_normals, c.half_angles, c.st + CS_C, c.C0, d_skip);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+
+// compress_ids, sync-free (H6): relabels ids[0, N) to dense ids in place and
+// writes the new count to d_count_out. d_n_real (nullable): number of REAL
+// entries at the front of ids (the rest are padding that sorts after them).
+void af_compress_ids(ChartsCtx& c, int* ids, int N, const int* d_n_real, int* d_count_out, const int* d_skip, cudaStream_t stream) {
+    const int grid = (N + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    arange_kernel<<<grid, BLOCK_SIZE, 0, stream>>>(c.cmp_indices, N);
+    CUDA_CHECK(cudaGetLastError());
+    {
+        size_t bytes = c.cub_temp_bytes;
+        CUDA_CHECK(cub::DeviceRadixSort::SortPairs(
+            c.cub_temp, bytes,
+            ids, c.cmp_sorted,
+            c.cmp_indices, c.cmp_argsorted,
+            N, 0, c.plain_end_bit, stream));
+    }
+    af_get_diff_kernel<<<grid, BLOCK_SIZE, 0, stream>>>(c.cmp_sorted, c.cmp_flags, N);
+    CUDA_CHECK(cudaGetLastError());
+    {
+        size_t bytes = c.cub_temp_bytes;
+        CUDA_CHECK(cub::DeviceScan::ExclusiveSum(c.cub_temp, bytes, c.cmp_flags, N, stream));
+    }
+    af_scatter_kernel<<<grid, BLOCK_SIZE, 0, stream>>>(c.cmp_argsorted, c.cmp_flags, N, d_skip, ids);
+    CUDA_CHECK(cudaGetLastError());
+    af_read_count_kernel<<<1, 1, 0, stream>>>(c.cmp_flags, d_n_real, N, d_skip, d_count_out);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+
+// One collapse round (steps 1-6 of the original while-loop body).
+void af_collapse_round(
+    CuMesh& mesh, ChartsCtx& c,
+    float threshold_cone_half_angle_rad, float area_penalty_weight, float perimeter_area_ratio_weight,
+    cudaStream_t stream
+) {
+    const int* skip = c.st + CS_WHILE_DONE;
+    const int M = c.M;
+
+    // 1. chart connectivity (CO1: c.key_shift/c.pair_end_bit narrow the
+    // packed (min_chart,max_chart) key when compact_chart_bits; both are
+    // fixed at 32/64 whenever this->deterministic, since det_expand_chart_
+    // keys_kernel below assumes the original encoding)
+    af_init_chart_adj_kernel<<<c.grid_M, BLOCK_SIZE, 0, stream>>>(
+        mesh.vertices.ptr, mesh.faces.ptr, mesh.manifold_face_adj.ptr, mesh.atlas_chart_ids.ptr,
+        M, skip, c.key_shift, c.chart_adj, c.raw_lengths);
+    CUDA_CHECK(cudaGetLastError());
+    {
+        size_t bytes = c.cub_temp_bytes;
+        CUDA_CHECK(cub::DeviceRadixSort::SortPairs(
+            c.cub_temp, bytes, c.chart_adj, c.sorted_keys, c.raw_lengths, c.sorted_lengths,
+            M, 0, c.pair_end_bit, stream));
+    }
+    if (c.det) {
+        // D1: deterministic run detection + segmented length sums
+        det_run_flags_kernel<<<c.grid_M, BLOCK_SIZE, 0, stream>>>(c.sorted_keys, M, c.det_flags);
+        CUDA_CHECK(cudaGetLastError());
+        {
+            size_t bytes = c.cub_temp_bytes;
+            CUDA_CHECK(cub::DeviceScan::ExclusiveSum(c.cub_temp, bytes, c.det_flags, c.det_run_index, M, stream));
+        }
+        det_scatter_runs_kernel<<<c.grid_M, BLOCK_SIZE, 0, stream>>>(
+            c.sorted_keys, c.det_flags, c.det_run_index, M, c.chart_adj, c.det_run_offsets, c.st + CS_NUM_RUNS);
+        CUDA_CHECK(cudaGetLastError());
+        af_segmented_reduce<float, float, cub::Sum, float>(
+            c.sorted_lengths, c.chart_adj_length, c.det_run_offsets, c.det_run_offsets + 1,
+            c.st + CS_NUM_RUNS, skip, M, cub::Sum(), float(), stream);
+    } else {
+        size_t bytes = c.cub_temp_bytes;
+        CUDA_CHECK(cub::DeviceReduce::ReduceByKey(
+            c.cub_temp, bytes, c.sorted_keys, c.chart_adj, c.sorted_lengths, c.chart_adj_length,
+            c.st + CS_NUM_RUNS, af_reduce_op(), M, stream));
+    }
+    af_trim_and_begin_kernel<<<1, 1, 0, stream>>>(c.st, c.chart_adj);
+    CUDA_CHECK(cudaGetLastError());
+
+    CUDA_CHECK(cudaMemsetAsync(c.chart2edge_cnt, 0, (c.C0 + 1) * sizeof(int), stream));
+    CUDA_CHECK(cudaMemsetAsync(c.chart_perims, 0, (c.C0 + 1) * sizeof(float), stream));
+    af_get_chart_edge_cnt_kernel<<<c.grid_M, BLOCK_SIZE, 0, stream>>>(
+        c.chart_adj, c.chart_adj_length, c.st + CS_E, M, skip, c.key_shift, c.key_mask, c.chart2edge_cnt, c.chart_perims);
+    CUDA_CHECK(cudaGetLastError());
+    {
+        size_t bytes = c.cub_temp_bytes;
+        CUDA_CHECK(cub::DeviceScan::ExclusiveSum(
+            c.cub_temp, bytes, c.chart2edge_cnt, c.chart2edge_offset, c.C0 + 1, stream));
+    }
+    if (c.det) {
+        // D3 + D2: sorted per-chart edge lists, sequential perimeters
+        det_expand_chart_keys_kernel<<<c.grid_M, BLOCK_SIZE, 0, stream>>>(
+            c.chart_adj, c.st + CS_E, M, skip, c.det_keys2, c.det_vals2);
+        CUDA_CHECK(cudaGetLastError());
+        {
+            size_t bytes = c.cub_temp_bytes;
+            CUDA_CHECK(cub::DeviceRadixSort::SortPairs(
+                c.cub_temp, bytes, c.det_keys2, c.det_sorted_keys2, c.det_vals2, c.chart2edge,
+                2 * M, 0, sizeof(int) * 8, stream));
+        }
+        det_chart_perim_kernel<<<c.grid_C0, BLOCK_SIZE, 0, stream>>>(
+            c.chart2edge, c.chart2edge_offset, c.chart_adj_length, c.st + CS_C, c.C0, skip, c.chart_perims);
+        CUDA_CHECK(cudaGetLastError());
+    } else {
+        CUDA_CHECK(cudaMemsetAsync(c.chart2edge_cnt, 0, (c.C0 + 1) * sizeof(int), stream));
+        af_get_chart_edge_adjacency_kernel<<<c.grid_M, BLOCK_SIZE, 0, stream>>>(
+            c.chart_adj, c.st + CS_E, M, skip, c.key_shift, c.key_mask, c.chart2edge, c.chart2edge_offset, c.chart2edge_cnt);
+        CUDA_CHECK(cudaGetLastError());
+    }
+
+    // 2. normal cones
+    af_compute_chart_normal_cones(mesh, c, skip, stream);
+
+    // 3. chart adjacency cost
+    af_compute_chart_adjacency_cost_kernel<<<c.grid_M, BLOCK_SIZE, 0, stream>>>(
+        c.chart_adj, c.cones, c.chart_adj_length, c.chart_perims, c.chart_areas,
+        area_penalty_weight, perimeter_area_ratio_weight, c.st + CS_E, M, skip,
+        c.key_shift, c.key_mask, c.edge_costs);
+    CUDA_CHECK(cudaGetLastError());
+
+    // 4. propagate costs
+    af_propagate_cost_kernel<<<c.grid_C0, BLOCK_SIZE, 0, stream>>>(
+        c.chart2edge, c.chart2edge_offset, c.edge_costs, c.st + CS_C, c.C0, skip, c.propagated);
+    CUDA_CHECK(cudaGetLastError());
+
+    // 5. collapse edges
+    arange_kernel<<<c.grid_C0, BLOCK_SIZE, 0, stream>>>(c.vertices_map, c.C0);
+    CUDA_CHECK(cudaGetLastError());
+    af_collapse_edges_kernel<<<c.grid_M, BLOCK_SIZE, 0, stream>>>(
+        c.chart_adj, c.edge_costs, c.propagated, threshold_cone_half_angle_rad,
+        c.st + CS_E, M, skip, c.key_shift, c.key_mask, c.skip_cone_writeback,
+        c.vertices_map, c.cones, c.st + CS_END_FLAG);
+    CUDA_CHECK(cudaGetLastError());
+    af_collapse_decide_kernel<<<1, 1, 0, stream>>>(c.st);
+    CUDA_CHECK(cudaGetLastError());
+
+    // 6. compress chart ids (skipped on-device once converged)
+    af_compress_ids(c, c.vertices_map, c.C0, c.st + CS_C, c.st + CS_C, skip, stream);
+    af_index_inplace_kernel<<<c.grid_F, BLOCK_SIZE, 0, stream>>>(
+        c.vertices_map, mesh.atlas_chart_ids.ptr, c.F, skip);
+    CUDA_CHECK(cudaGetLastError());
+}
