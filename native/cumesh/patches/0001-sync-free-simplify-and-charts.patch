+/**
+ * Deterministic mode helper (fastpixal3d_cumesh): sort each CSR segment
+ * [offsets[i], offsets[i+1]) ascending, in place (insertion sort; segments
+ * are short -- vertex valence). Optional device count / skip flag pointers
+ * for the sync-free paths (nullptr = unused).
+ */
+template<typename T>
+__global__ void sort_csr_segments_kernel(T* values, const int* offsets, const int N, const int* d_n, const int* d_skip) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= N) return;
+    if (d_skip != nullptr && *d_skip) return;
+    if (d_n != nullptr && tid >= *d_n) return;
+    const int b = offsets[tid];
+    const int e = offsets[tid + 1];
+    for (int i = b + 1; i < e; i++) {
+        T v = values[i];
+        int j = i - 1;
+        while (j >= b && values[j] > v) {
+            values[j + 1] = values[j];
+            j--;
+        }
+        values[j + 1] = v;
+    }
+}
