+// atlas_fast.cu -- sync-free variant of CuMesh::compute_charts (fastpixal3d_cumesh).
+//
+// This file is NEW code (not a rename of upstream atlas.cu). It implements
+// CuMesh::compute_charts_sync_free(), which runs the same algorithm as
+// CuMesh::compute_charts() (atlas.cu, kept callable and untouched apart from
+// the namespace rename) but with every per-round host decision moved to the
+// device, so the whole
+//     for global_iterations { while(true){collapse} for refine_iterations{refine} reassign }
+// loop nest is enqueued without a host<->device round trip per round.
+//
+// ---------------------------------------------------------------------------
+// HOST DECISION POINTS IN THE ORIGINAL (atlas.cu) AND THEIR REPLACEMENTS
+// (line numbers refer to sources/CuMesh/src/atlas.cu)
+//
+//  H1  get_chart_connectivity(): D2H read of ReduceByKey's num_runs into
+//      atlas_chart_adj.size (l.~571) and a second D2H read of the last key
+//      to trim the UINT64_MAX "same chart" sentinel run (l.~579-585).
+//      -> The sort + ReduceByKey run at the FIXED size M = manifold_face_adj
+//         .size (M never changes inside compute_charts: the mesh itself is
+//         not modified). num_runs is written straight into the device state
+//         (CS_NUM_RUNS); af_trim_and_begin_kernel (1 thread) applies the
+//         sentinel trim on-device and publishes E into CS_E. Every kernel
+//         that was launched with grid=E is launched with grid=ceil(M/BLOCK)
+//         and early-returns for tid >= CS_E.
+//
+//  H2  compute_charts(): `if (atlas_chart_adj.size == 0) break;` (l.~1121)
+//      -> af_trim_and_begin_kernel sets CS_WHILE_DONE when E == 0.
+//
+//  H3  get_chart_connectivity(): C = atlas_num_charts (host int) sizes
+//      chart2edge_cnt/perims/offset and the ExclusiveSum over C+1 (l.~596-640).
+//      -> Buffers are sized once at the upper bound C0 = F (charts only merge
+//         in the collapse loop; refine never creates ids; reassign can split
+//         charts but the count is trivially <= F). cnt/perims for c >= C stay
+//         zero (they are memset each round and only c < C are ever touched),
+//         so ExclusiveSum over C0+1 entries yields the identical prefix for
+//         [0, C] (an int exclusive sum at index i depends only on entries
+//         < i; entries >= C are 0). The offsets beyond C are never read.
+//
+//  H4  compute_chart_normal_cones(): C = atlas_num_charts (host int) is the
+//      num_segments argument of three cub::DeviceSegmentedReduce calls
+//      (l.~695-780) and sizes the RLE/ExclusiveSum that build the segment
+//      offsets (l.~660-690), each followed by cudaStreamSynchronize.
+//      -> Segment offsets are built by two kernels (fill with F, then scatter
+//         run starts from the sorted chart ids) into a C0+1 array; segments
+//         c >= C are empty. The three SegmentedReduce calls are replaced by
+//         af_segmented_reduce_kernel, which instantiates CUB's OWN
+//         cub::AgentReduce with the OWN policy CUB's DeviceSegmentedReduceKernel
+//         would pick for this arch (DeviceReducePolicy<...>::MaxPolicy::
+//         ActivePolicy::ReducePolicy) and runs ConsumeRange(begin,end) per
+//         segment exactly like that kernel, but loops over segments
+//         [blockIdx.x, *d_num_segments) with a fixed grid instead of one
+//         block per (host-known) segment. The per-segment reduction order is
+//         therefore the same code path as the original -> bit-identical
+//         chart areas / normals / cone half angles. (A plain cub call padded
+//         to C0 segments would work too but launches up to F ~ 25M empty
+//         blocks per call, ~3 calls per cones evaluation, ~330 evaluations
+//         per compute_charts: prohibitively slow.)
+//
+//  H5  compute_charts(): D2H read of end_flag after collapse_edges_kernel,
+//      `if (h_end_flag == 1) break;` (l.~1173-1175).
+//      -> af_collapse_decide_kernel (1 thread) sets CS_WHILE_DONE from the
+//         device end flag; the loop is a fixed `max_rounds` host loop in
+//         which every custom kernel early-exits once CS_WHILE_DONE is set,
+//         so post-convergence rounds are no-ops (the fixed-size CUB calls
+//         still run, on frozen inputs, and their outputs are never consumed
+//         once the flag is set). With `sync_every` > 0 the host additionally
+//         polls the flag every sync_every rounds so that the number of
+//         wasted (no-op) rounds is bounded by sync_every-1 -- see
+//         compute_charts_sync_free() for the exact accounting; sync_every=0
+//         gives the pure fixed-round form.
+//
+//  H6  compress_ids() (shared.h): D2H read of the number of unique ids
+//      (new atlas_num_charts), plus 4 cudaMalloc / 4 cudaFree per call.
+//      -> af_compress_ids(): same sort / diff / exclusive-sum / scatter
+//         pipeline on preallocated scratch at a fixed size N, with the count
+//         written to CS_C on-device (af_read_count_kernel reads the scanned
+//         diff array at index n_real-1, where n_real is CS_C for the padded
+//         vertices_map case and N for the chart_ids case). Padding for the
+//         vertices_map case: entries [C, C0) are their own index (arange),
+//         i.e. strictly larger than every real entry (< C), so they sort
+//         after all real entries and cannot change the dense relabeling of
+//         the real prefix; the diff flag of the last real sorted entry is 1
+//         either way (it differs from the first padding entry, matching the
+//         original's forced 1 at N-1).
+//
+//  H7  compute_charts(): the `swap_buffers(atlas_chart_ids, temp_storage)`
+//      after index_kernel (l.~1187) is a host-side pointer swap that must
+//      NOT happen in a skipped (post-convergence) round.
+//      -> The chart-id relabeling `ids[f] = map[ids[f]]` is done IN PLACE
+//         (each thread reads and writes only its own slot; map is read-only)
+//         by af_index_inplace_kernel, so no swap is needed. Result identical.
+//
+//  H8  reassign_chart_ids(): do { hook; compress; D2H read end_flag } while
+//      (end_flag == 0) (l.~880-905).
+//      -> Fixed `max_uf_passes` passes; af_uf_begin/af_uf_decide (1 thread)
+//         maintain CS_UF_END / CS_UF_DONE on-device and hook/compress
+//         early-exit once CS_UF_DONE is set (a converged pass is already a
+//         no-op for these kernels, the guard just makes it free). The final
+//         labels are order-independent: pointers only ever decrease
+//         (atomicMin), the minimum face id of a component is always a root,
+//         and at convergence every face of a component points to that
+//         minimum -> deterministic partition and labels regardless of how
+//         many passes it took.
+//
+//  H9  Every Buffer<T>::free()/resize() growth (cudaStreamSynchronize +
+//      cudaFree) and every cudaMalloc/cudaFree in the helpers.
+//      -> One arena allocation for all scratch, sized up front; one free at
+//         the end. cub temp storage is sized once to the max of all queries.
+//
+//  H10 The final `atlas_num_charts` (used by construct_chart_mesh and
+//      returned by read_atlas_charts) -> ONE D2H read at the very end (this
+//      is inherent: the caller needs the number on the host).
+//
+// DETERMINISTIC MODE (CuMesh::deterministic == true, opt-in, both paths):
+// the original algorithm is NOT run-to-run repeatable (measured: two
+// original compute_charts runs on the same 190k-face mesh assign 80-95% of
+// the faces to different charts), because of float atomicAdd perimeters,
+// ReduceByKey's look-back float sums, and atomic-ordered vert2face lists
+// (-> edge2face -> refine candidate order). Exact original-vs-sync-free
+// equality can therefore only be verified in a mode where both paths
+// replace those three constructs by order-fixed equivalents; see
+// atlas_det.cuh (D1-D3) and shared.h sort_csr_segments_kernel. In that mode
+// this file uses the SAME kernels as atlas.cu's get_chart_connectivity_det.
+//
+// What is deliberately NOT changed in the default mode (kept identical to the
+// original so the two paths see the same nondeterminism): get_chart_edge_cnt_kernel's
+// float atomicAdd perimeter accumulation and the atomicAdd slot assignment
+// in get_chart_edge_adjacency_kernel (order-independent consumer),
+// ReduceByKey's float length aggregation (CUB decoupled look-back), the
+// collapse/refine/hook kernels' arithmetic (copied verbatim, only an
+// early-exit guard and a device count pointer added).
+// ---------------------------------------------------------------------------
+
+#include "cumesh.h"
+#include "dtypes.cuh"
+#include "shared.h"
+#include "atlas_det.cuh"
+#include <cub/cub.cuh>
+#include <c10/cuda/CUDAStream.h>
+#include <algorithm>
+#include <vector>
+#include <limits>
+
+
+namespace fastpixal3d_cumesh_ns {
+
+// defined (non-static) in atlas.cu
+void construct_chart_mesh(CuMesh& mesh, cudaStream_t stream);
+
+namespace {
+
+// Device-resident state slots (int).
+enum {
+    CS_C = 0,          // current number of charts
+    CS_E = 1,          // current number of chart-adjacency edges (after sentinel trim)
+    CS_END_FLAG = 2,   // collapse round: 1 = no edge collapsed this round
+    CS_WHILE_DONE = 3, // collapse loop converged (or E == 0)
+    CS_ROUNDS = 4,     // number of collapse rounds executed this global iteration (incl. the terminating one)
+    CS_UF_END = 5,     // union-find pass: 1 = no hook happened
+    CS_UF_DONE = 6,    // union-find converged
+    CS_UF_PASSES = 7,  // union-find passes executed this global iteration
+    CS_NUM_RUNS = 8,   // ReduceByKey num_runs output (before sentinel trim)
+    CS_SIZE = 9,
+    CS_STATS_STRIDE = 4, // per global iteration: rounds, while_done, uf_passes, uf_done
+};
+
+constexpr int AF_SEGREDUCE_MAX_GRID = 8192;
+
+
+// CO1: smallest K such that (1<<K) > n, ROUNDED UP to a multiple of 4 (whole
+// number of cub::DeviceRadixSort's 8-bit digit passes) -- same helper as
+// simplify_fast.cu's sf_bits_needed (duplicated here rather than shared:
+// atlas_fast.cu and simplify_fast.cu are separate translation units, and
+// this is a 6-line, single-use-per-file helper, not worth a shared header
+// for). Host-only.
+inline int af_bits_needed(int n) {
+    int k = 1;
+    while ((int64_t(1) << k) <= int64_t(n)) k++;
+    return (k + 3) & ~3;
+}
+
+
+__device__ inline uint64_t af_pack_key_value_positive(int key, float value) {
+    unsigned int v = __float_as_uint(value);
+    return (static_cast<uint64_t>(v) << 32) |
+           static_cast<unsigned int>(key);
+}
+
+
+// Same functor body as atlas.cu's Float3Add (the type identity does not
+// affect the reduction order; only the operator body does).
+struct AfFloat3Add
+{
+    __host__ __device__
+    float3 operator()(const float3 &a, const float3 &b) const
+    {
+        return make_float3(a.x + b.x, a.y + b.y, a.z + b.z);
+    }
+};
+
+
+// ---------------------------------------------------------------------------
+// Fixed-grid replica of cub::DeviceSegmentedReduceKernel (H4).
+// ---------------------------------------------------------------------------
+template <typename ChainedPolicyT,
+          typename InputIteratorT,
+          typename OutputIteratorT,
+          typename OffsetIteratorT,
+          typename OffsetT,
+          typename ReductionOpT,
+          typename InitT,
+          typename AccumT>
+__global__ void __launch_bounds__(int(ChainedPolicyT::ActivePolicy::ReducePolicy::BLOCK_THREADS))
+af_segmented_reduce_kernel(
+    InputIteratorT d_in,
+    OutputIteratorT d_out,
+    OffsetIteratorT d_begin_offsets,
+    OffsetIteratorT d_end_offsets,
+    const int* d_num_segments,
+    const int* d_skip,
+    ReductionOpT reduction_op,
+    InitT init)
+{
+    // Same agent + policy as cub::DeviceSegmentedReduceKernel (dispatch_reduce.cuh).
+    using AgentReduceT =
+        cub::AgentReduce<typename ChainedPolicyT::ActivePolicy::ReducePolicy,
+                         InputIteratorT,
+                         OutputIteratorT,
+                         OffsetT,
+                         ReductionOpT,
+                         AccumT>;
+
+    __shared__ typename AgentReduceT::TempStorage temp_storage;
+
+    if (d_skip != nullptr && *d_skip) return;
+    const int num_segments = *d_num_segments;
+
+    for (int seg = blockIdx.x; seg < num_segments; seg += gridDim.x) {
+        OffsetT segment_begin = d_begin_offsets[seg];
+        OffsetT segment_end   = d_end_offsets[seg];
+
+        if (segment_begin == segment_end) {
+            if (threadIdx.x == 0) {
+                *(d_out + seg) = init;
+            }
+        } else {
+            AccumT block_aggregate = AgentReduceT(temp_storage, d_in, reduction_op).ConsumeRange(segment_begin, segment_end);
+            if (threadIdx.x == 0) {
+                // cub::detail::reduce::finalize_and_store_aggregate for a plain InitT
+                *(d_out + seg) = reduction_op(init, block_aggregate);
+            }
+        }
+        // The block-reduce scratch is reused by the next segment (the CUB
+        // kernel processes exactly one segment per block and needs no such
+        // barrier).
+        __syncthreads();
+    }
+}
+
+
+template <typename InputT, typename OutputT, typename ReductionOpT, typename InitT>
+void af_segmented_reduce(
+    InputT* d_in,
+    OutputT* d_out,
+    const int* d_begin_offsets,
+    const int* d_end_offsets,
+    const int* d_num_segments,
+    const int* d_skip,
+    int max_segments,
+    ReductionOpT reduction_op,
+    InitT init,
+    cudaStream_t stream)
+{
+    // Mirror DispatchSegmentedReduce's type derivation exactly
+    // (dispatch_reduce.cuh: OffsetT = offset iterator value type, InitT as
+    // passed by the DeviceSegmentedReduce wrapper, AccumT =
+    // __accumulator_t<Op, value_t<InputIt>, InitT>).
+    using OffsetT = int;
+    using AccumT = ::cuda::std::__accumulator_t<ReductionOpT, InputT, InitT>;
+    using PolicyHub = cub::DeviceReducePolicy<AccumT, OffsetT, ReductionOpT>;
+    using MaxPolicyT = typename PolicyHub::MaxPolicy;
+    // All of CUB 2.x's reduce policies use 256 threads; the device side
+    // resolves ActivePolicy via __CUDA_ARCH__, the host side must launch with
+    // the same block size.
+    constexpr int BLOCK_THREADS = PolicyHub::Policy600::ReducePolicy::BLOCK_THREADS;
+    static_assert(PolicyHub::Policy350::ReducePolicy::BLOCK_THREADS == BLOCK_THREADS, "policy block size mismatch");
+    static_assert(PolicyHub::Policy300::ReducePolicy::BLOCK_THREADS == BLOCK_THREADS, "policy block size mismatch");
+
+    int grid = std::min(std::max(max_segments, 1), AF_SEGREDUCE_MAX_GRID);
+    af_segmented_reduce_kernel<MaxPolicyT, InputT*, OutputT*, const int*, OffsetT, ReductionOpT, InitT, AccumT>
+        <<<grid, BLOCK_THREADS, 0, stream>>>(
+            d_in, d_out, d_begin_offsets, d_end_offsets, d_num_segments, d_skip, reduction_op, init);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+
+// ---------------------------------------------------------------------------
+// Kernels: verbatim copies of atlas.cu's static kernels with (a) a device
+// count pointer instead of a host int for the shrinking sizes and (b) an
+// early-exit on the device skip flag.
+// ---------------------------------------------------------------------------
+
+__global__ void af_init_chart_adj_kernel(
+    const float3* vertices,
+    const int3* faces,
+    const int2* face_adj,
+    const int* chart_ids,
+    const int M,
+    const int* d_skip,
+    const int key_shift,
+    uint64_t* chart_adj,
+    float* length
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= M) return;
+    if (*d_skip) return;
+
+    int f0 = face_adj[tid].x;
+    int f1 = face_adj[tid].y;
+
+    int c0 = chart_ids[f0];
+    int c1 = chart_ids[f1];
+
+    if (c0 == c1) {
+        chart_adj[tid] = UINT64_MAX;
+        length[tid] = 0.0f;
+        return;
+    }
+
+    int min_c = min(c0, c1);
+    int max_c = max(c0, c1);
+    // CO1: key_shift is 32 (fixed encoding) unless compact_chart_bits, in
+    // which case it's K = af_bits_needed(C0) -- see header "CO1". Either
+    // way this is an order-preserving injection (see compute_charts_sync_
+    // free's own comment on why UINT64_MAX still sorts last), so the sort/
+    // ReduceByKey output is unaffected.
+    chart_adj[tid] = (static_cast<uint64_t>(min_c) << key_shift) | static_cast<uint64_t>(max_c);
+
+    int3 tri0 = faces[f0];
+    int3 tri1 = faces[f1];
+
+    int t0_indices[3] = {tri0.x, tri0.y, tri0.z};
+    int common_v_indices[2];
+    int found_count = 0;
+
+    #pragma unroll
+    for (int i = 0; i < 3; ++i) {
+        int v = t0_indices[i];
+        if (v == tri1.x || v == tri1.y || v == tri1.z) {
+            if (found_count < 2) {
+                common_v_indices[found_count] = v;
+            }
+            found_count++;
+        }
+    }
+
+    if (found_count >= 2) {
+        float3 p0 = vertices[common_v_indices[0]];
+        float3 p1 = vertices[common_v_indices[1]];
+
+        float dx = p0.x - p1.x;
+        float dy = p0.y - p1.y;
+        float dz = p0.z - p1.z;
+
+        length[tid] = sqrtf(dx * dx + dy * dy + dz * dz);
+    } else {
+        length[tid] = 0.0f;
+    }
+}
+
+
+// H1 + H2 + the per-round `h_end_flag = 1` reset, in one thread.
+__global__ void af_trim_and_begin_kernel(int* st, const uint64_t* chart_adj) {
+    if (st[CS_WHILE_DONE]) return;
+    st[CS_END_FLAG] = 1;
+    st[CS_ROUNDS] += 1;
+    int E = st[CS_NUM_RUNS];
+    if (E > 0 && chart_adj[E - 1] == UINT64_MAX) E -= 1;
+    st[CS_E] = E;
+    if (E == 0) st[CS_WHILE_DONE] = 1;
+}
+
+
+__global__ void af_get_chart_edge_cnt_kernel(
+    const uint64_t* chart_adj,
+    const float* chart_adj_length,
+    const int* d_E,
+    const int M,
+    const int* d_skip,
+    const int key_shift, const uint64_t key_mask,
+    int* chart2edge_cnt,
+    float* chart_perim
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= M) return;
+    if (*d_skip) return;
+    if (tid >= *d_E) return;
+
+    // get edge
+    uint64_t c = chart_adj[tid];
+    float l = chart_adj_length[tid];
+    int c0 = int(c >> key_shift);
+    int c1 = int(c & key_mask);
+
+    // count vertex adjacent edge number
+    atomicAdd(&chart2edge_cnt[c0], 1);
+    atomicAdd(&chart2edge_cnt[c1], 1);
+    atomicAdd(&chart_perim[c0], l);
+    atomicAdd(&chart_perim[c1], l);
+}
+
+
+__global__ void af_get_chart_edge_adjacency_kernel(
+    const uint64_t* chart_adj,
+    const int* d_E,
+    const int M,
+    const int* d_skip,
+    const int key_shift, const uint64_t key_mask,
+    int* chart2edge,
+    int* chart2edge_offset,
+    int* chart2edge_cnt
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= M) return;
+    if (*d_skip) return;
+    if (tid >= *d_E) return;
+
+    // get edge
+    uint64_t c = chart_adj[tid];
+    int c0 = int(c >> key_shift);
+    int c1 = int(c & key_mask);
+
+    // assign connectivity
+    chart2edge[chart2edge_offset[c0] + atomicAdd(&chart2edge_cnt[c0], 1)] = tid;
+    chart2edge[chart2edge_offset[c1] + atomicAdd(&chart2edge_cnt[c1], 1)] = tid;
+}
+
+
+__global__ void af_compute_chart_adjacency_cost_kernel(
+    const uint64_t* chart_adj,
+    const float4* chart_normal_cones,
+    const float* chart_adj_length,
+    const float* chart_perims,
+    const float* chart_areas,
+    float area_penalty_weight,
+    float perimeter_area_ratio_weight,
+    const int* d_E,
+    const int M,
+    const int* d_skip,
+    const int key_shift, const uint64_t key_mask,
+    float* chart_adj_costs
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= M) return;
+    if (*d_skip) return;
+    if (tid >= *d_E) return;
+
+    uint64_t adj = chart_adj[tid];
+    int c0 = static_cast<int>(adj >> key_shift);
+    int c1 = static_cast<int>(adj & key_mask);
+
+    float4 cone0 = chart_normal_cones[c0];
+    float4 cone1 = chart_normal_cones[c1];
+    Vec3f axis0(cone0.x, cone0.y, cone0.z);
+    Vec3f axis1(cone1.x, cone1.y, cone1.z);
+    float half_angle0 = cone0.w;
+    float half_angle1 = cone1.w;
+    float cos_angle = axis0.dot(axis1);
+    float axis_angle = acosf(fmaxf(fminf(cos_angle, 1.0f), -1.0f));
+    float new_cone_low = fminf(-half_angle0, axis_angle - half_angle1);
+    float new_cone_high = fmaxf(half_angle0, axis_angle + half_angle1);
+    float new_half_angle = (new_cone_high - new_cone_low) * 0.5f;
+    float cost = new_half_angle;
+
+    // Chart area panelty
+    float new_area = (chart_areas[c0] + chart_areas[c1]);
+    cost += area_penalty_weight * new_area;
+
+    // Perim-area ration panelty
+    float new_perim = chart_perims[c0] + chart_perims[c1] - 2 * chart_adj_length[tid];
+    cost += perimeter_area_ratio_weight * (new_perim * new_perim / new_area);
+
+    chart_adj_costs[tid] = cost;
+}
+
+
+__global__ void af_propagate_cost_kernel(
+    const int* chart2edge,
+    const int* chart2edge_offset,
+    const float* edge_collapse_costs,
+    const int* d_C,
+    const int C0,
+    const int* d_skip,
+    uint64_t* propagated_costs
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= C0) return;
+    if (*d_skip) return;
+    if (tid >= *d_C) return;
+
+    // get edge with minimum cost
+    int min_eid = -1;
+    float min_cost = FLT_MAX;
+    for (int e = chart2edge_offset[tid]; e < chart2edge_offset[tid+1]; e++) {
+        int eid = chart2edge[e];
+        float cost = edge_collapse_costs[eid];
+        if (cost < min_cost || (cost == min_cost && eid < min_eid)) {
+            min_eid = eid;
+            min_cost = cost;
+        }
+    }
+
+    uint64_t cost = af_pack_key_value_positive(min_eid, min_cost);
+    propagated_costs[tid] = cost;
+}
+
+
+__global__ void af_collapse_edges_kernel(
+    uint64_t* chart_adj,
+    const float* edge_collapse_costs,
+    const uint64_t* propagated_costs,
+    const float collapse_thresh,
+    const int* d_E,
+    const int M,
+    const int* d_skip,
+    const int key_shift, const uint64_t key_mask,
+    const bool skip_cone_writeback,
+    int* chart_map,
+    float4* chart_normal_cones,
+    int* end_flag
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= M) return;
+    if (*d_skip) return;
+    if (tid >= *d_E) return;
+
+    float cost = edge_collapse_costs[tid];
+    if (cost > collapse_thresh) return;
+
+    // get edge
+    uint64_t c = chart_adj[tid];
+    int c0 = int(c >> key_shift);
+    int c1 = int(c & key_mask);
+
+    // check if this edge has the minimum cost among neighboring charts
+    uint64_t pack = af_pack_key_value_positive(tid, cost);
+    if (propagated_costs[c0] < pack || propagated_costs[c1] < pack) return;
+
+    // collapse edge
+    chart_map[c1] = c0;
+    *end_flag = 0;
+
+    // CO2: this cone update is PROVABLY dead in the current call pattern --
+    // see the header comment "CO2" for the full data-flow argument (every
+    // round that runs for real starts with af_compute_chart_normal_cones
+    // fully recomputing chart_normal_cones[] from the actual face data via
+    // a fresh segmented reduce, unconditionally overwriting whatever this
+    // write produced; refine's own call to that function also always runs
+    // unconditionally, d_skip=nullptr). skip_cone_writeback=true skips it
+    // entirely; default false keeps the original (redundant but harmless)
+    // computation for a conservative, bit-for-bit-safe default.
+    if (skip_cone_writeback) return;
+
+    // update cone
+    float4 cone0 = chart_normal_cones[c0];
+    float4 cone1 = chart_normal_cones[c1];
+    Vec3f axis0(cone0.x, cone0.y, cone0.z);
+    Vec3f axis1(cone1.x, cone1.y, cone1.z);
+    float half_angle0 = cone0.w;
+    float half_angle1 = cone1.w;
+    float cos_angle = axis0.dot(axis1);
+    float axis_angle = acosf(fmaxf(fminf(cos_angle, 1.0f), -1.0f));
+    float new_cone_low = fminf(-half_angle0, axis_angle - half_angle1);
+    float new_cone_high = fmaxf(half_angle0, axis_angle + half_angle1);
+    float new_half_angle = (new_cone_high - new_cone_low) * 0.5f;
+    Vec3f new_axis;
+    if (axis_angle < 1e-3f) {
+        new_axis = axis0;
+    } else {
+        float new_axis_angle = (new_cone_high + new_cone_low) * 0.5f;
+        new_axis = axis0 * cosf(new_axis_angle) + (axis1 - axis0 * cos_angle).normalized() * sinf(new_axis_angle);
+        new_axis.normalize();
+    }
+    chart_normal_cones[c0] = make_float4(new_axis.x, new_axis.y, new_axis.z, new_half_angle);
+}
+
+
+// H5: the `if (h_end_flag == 1) break;` decision.
+__global__ void af_collapse_decide_kernel(int* st) {
+    if (st[CS_WHILE_DONE]) return;
+    if (st[CS_END_FLAG] == 1) st[CS_WHILE_DONE] = 1;
+}
