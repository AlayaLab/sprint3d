+// Segment offsets from the sorted (dense, every id in [0,C) present) chart
+// ids: offsets[c] = first sorted position of c; offsets[c] for c >= C was
+// pre-filled with F by af_fill_int_kernel, so those segments are empty and
+// offsets[C] == F as in the original's exclusive sum.
+__global__ void af_segment_starts_kernel(const int* sorted_chart_ids, const int F, const int* d_skip, int* offsets) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= F) return;
+    if (d_skip != nullptr && *d_skip) return;
