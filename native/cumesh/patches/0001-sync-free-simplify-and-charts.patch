+
+__global__ void af_normalize_kernel(float3* chart_normals, const int* d_C, const int C0, const int* d_skip) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= C0) return;
+    if (d_skip != nullptr && *d_skip) return;
+    if (tid >= *d_C) return;
+
+    float3 n = chart_normals[tid];
+    float norm = sqrtf(n.x * n.x + n.y * n.y + n.z * n.z);
+    if (norm > 0.0f) {
+        n.x /= norm;
+        n.y /= norm;
+        n.z /= norm;
+    }
+    chart_normals[tid] = n;
+}
+
+
+__global__ void af_normal_diff_kernel(
+    const float3* chart_normals,
+    const float3* sorted_face_normals,
+    const int* sorted_chart_ids,
+    const int F,
+    const int* d_skip,
+    float* normal_diff
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= F) return;
+    if (d_skip != nullptr && *d_skip) return;
+
+    int c = sorted_chart_ids[tid];
+    Vec3f n(chart_normals[c]);
+    Vec3f fn(sorted_face_normals[tid]);
+    normal_diff[tid] = acosf(fmaxf(fminf(n.dot(fn), 1.0f), -1.0f));
+}
