+struct ChartsCtx {
+    int F = 0, M = 0, C0 = 0;
+    int grid_F = 0, grid_M = 0, grid_C0 = 0, grid_C0p1 = 0;
+    // CO1-CO3 (see compute_charts_sync_free's own header comment): all
+    // default to the plain sync-free behaviour. key_shift/key_mask/pair_end_bit
+    // pack/unpack the chart_adj (min_chart,max_chart) sort key (disabled
+    // whenever `deterministic`, since det_expand_chart_keys_kernel --
+    // shared, unmodified, with atlas.cu's own get_chart_connectivity_det --
+    // assumes the fixed 32/64 encoding); plain_end_bit narrows the two
+    // plain-int sorts (face-by-chart-id in af_compute_chart_normal_cones,
+    // and af_compress_ids' internal sort) unconditionally (unrelated to the
+    // chart_adj pair encoding, safe in both modes -- see header "CO1").
+    bool compact_chart_bits = false;
+    int key_shift = 32;
+    uint64_t key_mask = 0xFFFFFFFFull;
+    int pair_end_bit = 64;
+    int plain_end_bit = 32;
+    bool skip_cone_writeback = false;  // CO2
+    bool fuse_round_kernels = false;   // CO3
+    int* st = nullptr;
+    // connectivity
+    float* raw_lengths = nullptr;
+    uint64_t* sorted_keys = nullptr;
+    float* sorted_lengths = nullptr;
+    uint64_t* chart_adj = nullptr;
+    float* chart_adj_length = nullptr;
+    int* chart2edge_cnt = nullptr;     // C0 + 1
+    float* chart_perims = nullptr;     // C0 + 1
+    int* chart2edge_offset = nullptr;  // C0 + 1
+    int* chart2edge = nullptr;         // 2M
+    float* edge_costs = nullptr;       // M
+    uint64_t* propagated = nullptr;    // C0
+    int* vertices_map = nullptr;       // C0
+    float4* cones = nullptr;           // C0
+    float* chart_areas = nullptr;      // C0
+    // cones
+    int* sorted_chart_ids = nullptr;   // F
+    int* faces_ids = nullptr;          // F
+    int* argsorted_faces_ids = nullptr;// F
+    int* chart_offsets = nullptr;      // C0 + 1
+    float* sorted_face_areas = nullptr;// F
+    float3* sorted_face_normals = nullptr; // F
+    float3* chart_normals = nullptr;   // C0
+    float* normal_diff = nullptr;      // F
+    float* half_angles = nullptr;      // C0
+    // compress
+    int* cmp_indices = nullptr;        // F
+    int* cmp_argsorted = nullptr;      // F
+    int* cmp_sorted = nullptr;         // F
+    int* cmp_flags = nullptr;          // F
+    // deterministic mode (D1-D3), only carved when mesh.deterministic
+    bool det = false;
+    int* det_flags = nullptr;          // M
+    int* det_run_index = nullptr;      // M
+    int* det_run_offsets = nullptr;    // M + 1
+    int* det_keys2 = nullptr;          // 2M
+    int* det_sorted_keys2 = nullptr;   // 2M
+    int* det_vals2 = nullptr;          // 2M
+    // cub
+    char* cub_temp = nullptr;
+    size_t cub_temp_bytes = 0;
+    int num_state = 0;
+
+    void carve(Arena& a, int global_iterations) {
+        num_state = CS_SIZE + CS_STATS_STRIDE * global_iterations;
+        st = a.take<int>(num_state);
+        raw_lengths = a.take<float>(M);
+        sorted_keys = a.take<uint64_t>(M);
+        sorted_lengths = a.take<float>(M);
+        chart_adj = a.take<uint64_t>(M);
+        chart_adj_length = a.take<float>(M);
+        chart2edge_cnt = a.take<int>(C0 + 1);
+        chart_perims = a.take<float>(C0 + 1);
+        chart2edge_offset = a.take<int>(C0 + 1);
+        chart2edge = a.take<int>(2 * (size_t)M);
+        edge_costs = a.take<float>(M);
+        propagated = a.take<uint64_t>(C0);
+        vertices_map = a.take<int>(C0);
+        cones = a.take<float4>(C0);
+        chart_areas = a.take<float>(C0);
+        sorted_chart_ids = a.take<int>(F);
+        faces_ids = a.take<int>(F);
+        argsorted_faces_ids = a.take<int>(F);
+        chart_offsets = a.take<int>(C0 + 1);
+        sorted_face_areas = a.take<float>(F);
+        sorted_face_normals = a.take<float3>(F);
+        chart_normals = a.take<float3>(C0);
+        normal_diff = a.take<float>(F);
+        half_angles = a.take<float>(C0);
+        cmp_indices = a.take<int>(F);
+        cmp_argsorted = a.take<int>(F);
+        cmp_sorted = a.take<int>(F);
+        cmp_flags = a.take<int>(F);
+        if (det) {
+            det_flags = a.take<int>(M);
+            det_run_index = a.take<int>(M);
+            det_run_offsets = a.take<int>((size_t)M + 1);
+            det_keys2 = a.take<int>(2 * (size_t)M);
+            det_sorted_keys2 = a.take<int>(2 * (size_t)M);
+            det_vals2 = a.take<int>(2 * (size_t)M);
+        }
+        cub_temp = a.take<char>(cub_temp_bytes);
+    }
+};
