+// simplify_fast.cu -- sync-free variant of CuMesh::simplify_step's round loop
+// (fastpixal3d_cumesh).
+//
+// CuMesh::simplify_sync_free() runs the ENTIRE round loop that cumesh.py's
+// `simplify()` drives from Python (one `simplify_step()` call per round, with
+// the "removed<1% -> thresh*=10" / "reached target -> stop" decision made in
+// Python between calls) as a single C++ call whose rounds are enqueued without
+// a host<->device round trip per round.
+//
+// ---------------------------------------------------------------------------
+// HOST DECISION POINTS IN THE ORIGINAL AND THEIR REPLACEMENTS
+//
+//  S1  cumesh.py simplify(): reads new_num_face (returned by simplify_step)
+//      and decides (a) new_num_face <= target -> stop, else (b)
+//      del_num_face / num_face < 1e-2 -> thresh *= 10 (Python doubles; the
+//      threshold is cast to float only when passed to simplify_step).
+//      -> sf_decision_kernel (1 thread) makes the same comparisons on the
+//         device-resident counters, in the same order, in DOUBLE precision
+//         (the ratio and the threshold escalation are double ops exactly like
+//         Python's; the collapse kernel casts the double threshold to float
+//         at the comparison, exactly like the Python->C++ float argument).
+//
+//  S2  connectivity.cu get_edges(): D2H read of RunLengthEncode's num_runs
+//      into edges.size (host grid size for all later per-edge kernels).
+//      -> sort + RLE run at the FIXED size E0 = 3*F0 (F0 = faces on entry,
+//         an upper bound: faces only decrease). The unused tail [3F, 3F0) is
+//         filled with a GHOST sentinel edge (GHOST, GHOST), GHOST = V0, which
+//         sorts after every real edge and collapses to exactly one trailing
+//         run whose multiplicity (3*(F0-F), a multiple of 3) can never be 1,
+//         so it is never a boundary edge; every per-edge kernel skips it.
+//         num_runs is written straight into the device state (STATE_NUM_EDGES)
+//         and every per-edge kernel is launched at grid=ceil(E0/BLOCK) and
+//         early-returns for tid >= *d_num_edges.
+//
+//  S3  connectivity.cu get_boundary_info(): D2H read of DeviceSelect::If's
+//      boundary count (host grid size for set_boundary_vertex_kernel).
+//      -> simplify only consumes vert_is_boundary (never the compacted
+//         `boundaries` list), so sf_mark_boundary_vertices_kernel flags an
+//         edge's endpoints iff its RLE multiplicity is exactly 1 -- the same
+//         predicate (is_boundary_edge) -- directly from the fixed-size arrays.
+//
+//  S4  simplify.cu collapse_edges(): two D2H reads of the ExclusiveSum
+//      totals (new vertex / face counts) to size the compacted outputs and
+//      the next round's host grid sizes.
+//      -> ping-pong buffers preallocated at V0/F0; the scans run at the fixed
+//         sizes V0+1/F0+1 over maps whose padding tail is 0 (sf_mark_valid_
+//         kernel), so the totals sit at the FIXED indices V0/F0 and are
+//         copied device-to-device into the state (sf_update_counts_kernel).
+//
+//  S5  shared.h Buffer<T>::free() (cudaStreamSynchronize + cudaFree) called
+//      ~10x per round by clear_cache(), Buffer<T>::fill() (host vector
+//      round trip + sync) in collapse_edges()/propagate_cost(), and the
+//      per-round cudaMalloc/cudaFree of get_edges()/get_boundary_info().
+//      -> one arena allocation for the whole call, fill via kernels,
+//         clear_cache() once after the loop.
+//
+//  S6  The while(true) itself: fixed `max_rounds` host loop; once
+//      STATE_DONE is set every round is a no-op. With `sync_every` > 0 the
+//      host polls the flag every sync_every rounds and stops early
+//      (bounding the wasted no-op rounds by sync_every-1); sync_every = 0
+//      is the pure fixed-round form. The final (V, F) is read back once.
+//
+// ---------------------------------------------------------------------------
+// CORRECTNESS NOTES (pitfalls of a naive sync-free loop and how they are avoided)
+//
+//  B1  Post-convergence rounds must be idempotent: sf_mark_valid_
+//      kernel and sf_collapse_edges_kernel were skipped once STATE_DONE was
+//      set, but the in-place cub::DeviceScan::ExclusiveSum on vertices_map/
+//      faces_map still ran every round, re-scanning an already-scanned array
+//      (values explode), and the unguarded compress kernels then indexed the
+//      pong buffers with those values (out of bounds -> illegal memory
+//      access); additionally swap_buffers() ran unconditionally on the host,
+//      so even without the OOB the mesh would have been swapped with stale
+//      pong data. Now: sf_mark_valid_kernel always runs (all-ones over the
+//      frozen [0,V)/[0,F) prefix), the collapse is skipped, so the scan is
+//      the identity map, the compress copies the frozen mesh into the pong
+//      unchanged, the swap is harmless, and the counts re-derive to the same
+//      values. Post-convergence rounds are true no-ops (and the derive-only
+//      kernels early-exit on the flag to make them cheaper).
+//
+//  B2  Threshold escalation was done in float on device (float(1e-8)*10.0f),
+//      whereas Python escalates a double and casts to float per call
+//      (float(1e-7)) -- these differ by an ulp for some steps, changing the
+//      `cost > thresh` comparison in rare cases. Now double, cast at use.
+//
+//  B3  The <1% ratio was computed in float; Python uses double. Now double.
+//
+//  B4  18 separate Buffer allocations (18 cudaMalloc + 18 synchronizing
+//      cudaFree per call) -> one arena.
+//
+// DETERMINISTIC MODE (CuMesh::deterministic, opt-in, both paths): the
+// original simplify is not run-to-run repeatable (measured: different final
+// face counts on every mesh tried) because fill_neighbor_face_ids_kernel's
+// atomicAdd slot assignment makes each vertex's face list hardware-ordered,
+// and get_qem_kernel / the skinny term sum floats in that order. With the
+// flag set, both paths sort every vertex's face list (shared.h
+// sort_csr_segments_kernel) right after building it; nothing else changes.
+// ---------------------------------------------------------------------------
+//
+// OPTIONAL SPEED-UPS (all four default to the plain sync-free behaviour; each
+// is independently switchable).
+//
+//  O1 compact_edge_bits -- S2's edge key is packed as (min_vid << 32) |
+//     max_vid and radix-sorted over the full 64 bits (0..63), even though a
+//     mesh's vertex count V0 (and GHOST=V0, the padding sentinel) almost
+//     always fits in far fewer than 32 bits: on the remesh ->
+//     simplify path the mesh entering simplify has O(1e5-1e6)
+//     vertices, needing ~17-21 bits, not 32. cub::DeviceRadixSort's Onesweep
+//     kernel issues one kernel launch per 8-bit digit pass, so sorting the
+//     full 64 bits costs 8 launches/round regardless of how few bits are
+//     actually live (a profile shows exactly 8 DeviceRadixSortOnesweepKernel
+//     launches per simplify round).
+//     With this flag, both the pack (sf_expand_edges_padded_kernel) and
+//     every unpack (sf_mark_boundary_vertices_kernel,
+//     sf_get_edge_collapse_cost_kernel, sf_propagate_cost_kernel,
+//     sf_collapse_edges_kernel -- ALL FOUR kernels that decode an edge's
+//     (e0,e1) from its packed key) use a dynamic key_shift = K = ceil(log2(V0+1)) bits
+//     per half (instead of the fixed 32), and the sort's end_bit narrows
+//     from 64 to 2*K. This is a
+//     REPACKING, not a truncation: for any V0, the map (min,max) -> (min<<K)
+//     | max is injective (both halves fit in K bits by construction) and
+//     strictly order-preserving in the same lexicographic (min,max) sense
+//     the original (min<<32)|max encoding already used -- the sort produces
+//     the IDENTICAL partition into unique edges, the IDENTICAL RLE run
+//     structure/multiplicities, and therefore an IDENTICAL boundary/interior
+//     classification and edge list order to the fixed-64-bit encoding. K is
+//     computed once per simplify_sync_free() call (host-side, from the
+//     already-known V0 -- no extra device sync) and held fixed for every
+//     round of that call, exactly like V0/F0/E0 already are.
+//
+//  O2 ratio_thresh / escalation_factor -- sf_decision_kernel's "removed
+//     <1% of faces this round -> threshold *= 10" rule (S1) had both
+//     constants (1e-2, 10.0) hardcoded to match the Python loop's
+//     hardcoded values. Both are now call parameters (still defaulting to
+//     1e-2 / 10.0, i.e. byte-identical decisions when left at default). A
+//     more aggressive ramp (higher escalation_factor and/or higher
+//     ratio_thresh) makes the per-round accepted threshold grow faster,
+//     which -- through the SAME cost<=threshold acceptance rule (unchanged)
+//     and the SAME conflict-free per-face-argmin batch selection (unchanged)
+//     -- tends to admit a larger accepted-collapse batch per round and reach
+//     target_num_faces in fewer total rounds. This changes the ORDER/PATH of
+//     collapses (which edges end up in which round's batch) but not the
+//     collapse acceptance criterion itself -- the same kind of run-to-run
+//     difference the default (non-deterministic) mode already has.
+//
+//  O3 fuse_round_kernels -- sf_update_counts_kernel and sf_decision_kernel
+//     are two single-thread kernels that already run back-to-back at the
+//     end of every round with a strict data dependency (decision reads the
+//     counts update just wrote) and no other kernel in between. Fusing them
+//     into one sf_finish_round_kernel (literally the two kernel bodies
+//     concatenated, same reads/writes, same order) removes one kernel-
+//     launch's host overhead per round without changing any value computed
+//     -- a pure mechanical fusion, unlike O1/O2 it cannot change output even
+//     in principle.
+//
+//  O4 use_cuda_graph -- every kernel launched inside the round loop uses
+//     fixed device pointers (the arena) and fixed grid/block sizes for the
+//     whole call (V0/F0/E0 do not change; only the DATA in the buffers
+//     changes round to round), and none of them allocate memory (the arena
+//     and cub_temp are both sized and allocated once, before the loop) --
+//     exactly the condition CUDA graph capture needs. With this flag, one
+//     round's kernel sequence is captured once (cudaStreamBeginCapture /
+//     cudaStreamEndCapture on the current stream, capturing but NOT
+//     executing that first round) and replayed with cudaGraphLaunch for
+//     every round instead of re-issuing ~20 individual kernel launches from
+//     the host each time; the sync_every host poll is unchanged (still runs
+//     between graph launches at the same cadence). If capture or
+//     instantiation fails for any reason, this falls back to the normal
+//     per-kernel-launch loop for the whole call (logged via a thrown-and-
+//     caught exception path, not silently -- see the C++ body below).
+// ---------------------------------------------------------------------------
+
+#include "cumesh.h"
+#include "dtypes.cuh"
+#include "shared.h"
+#include <cub/cub.cuh>
+#include <ATen/cuda/CUDAGraph.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/cuda/CUDAStream.h>
+#include <algorithm>
+#include <exception>
+#include <limits>
+#include <vector>
+
+
+namespace fastpixal3d_cumesh_ns {
+
+namespace {
+
+enum {
+    STATE_NUM_VERTICES = 0,
+    STATE_NUM_FACES = 1,
+    STATE_PREV_NUM_FACES = 2,
+    STATE_DONE = 3,
+    STATE_NUM_EDGES = 4,   // RunLengthEncode's num_runs output (real unique edges + the ghost run, if any)
+    STATE_ROUNDS = 5,      // rounds that actually ran a collapse step
+    STATE_SIZE = 6,
+};
+
+
+// O1: smallest K such that (1<<K) > n, i.e. every value in [0, n] (n itself
+// included -- the GHOST sentinel is set to V0) fits in K bits, ROUNDED UP to
+// a multiple of 4 so the sort's end_bit (2*K) is always a multiple of 8 -- a
+// whole number of cub::DeviceRadixSort's 8-bit digit passes, matching every
+// other end_bit this codebase already exercises (0 or 64). Kept as a
+// defensive, convention-matching margin: whether a non-multiple-of-8 end_bit is
+// safe on every CUB version has not been verified. Host-only, computed
+// once per simplify_sync_free() call from V0.
+inline int sf_bits_needed(int n) {
+    int k = 1;
+    while ((int64_t(1) << k) <= int64_t(n)) k++;
+    return (k + 3) & ~3;
+}
+
+
+__device__ inline uint64_t sf_pack_key_value_positive(int key, float value) {
+    unsigned int v = __float_as_uint(value);
+    return (static_cast<uint64_t>(v) << 32) | static_cast<unsigned int>(key);
+}
+
+
+// Mirrors process_incident_tri() in simplify.cu exactly.
+__device__ inline bool sf_process_incident_tri(
+    int tri_idx,
+    int collapse_keep_vert,
+    int collapse_other_vert,
+    const float3* vertices,
+    const int3* faces,
+    const Vec3f& v_new,
+    float& skinny_cost,
+    int& num_tri
+) {
+    const float EPS = 1e-12f;
+    int3 f_vids = faces[tri_idx];
+
+    if (f_vids.x == collapse_other_vert || f_vids.y == collapse_other_vert || f_vids.z == collapse_other_vert)
+        return true;
+
+    Vec3f a(vertices[f_vids.x]);
+    Vec3f b(vertices[f_vids.y]);
+    Vec3f c(vertices[f_vids.z]);
+
+    Vec3f na = (f_vids.x == collapse_keep_vert) ? v_new : a;
+    Vec3f nb = (f_vids.y == collapse_keep_vert) ? v_new : b;
+    Vec3f nc = (f_vids.z == collapse_keep_vert) ? v_new : c;
+
+    Vec3f old_e1 = b - a;
+    Vec3f old_e2 = c - a;
+    Vec3f old_normal = old_e1.cross(old_e2);
+    float old_area = 0.5f * old_normal.norm();
+    (void)old_area;
+
+    Vec3f new_e1 = nb - na;
+    Vec3f new_e2 = nc - na;
+    Vec3f new_normal = new_e1.cross(new_e2);
+    float new_area = 0.5f * new_normal.norm();
+
+    if (old_normal.dot(new_normal) < 0.0f) {
+        return false;
+    }
+
+    Vec3f new_e0 = nc - nb;
+    float denom = new_e0.norm2() + new_e1.norm2() + new_e2.norm2();
+    if (denom < EPS) denom = EPS;
+    float shapeMetric = 4.0f * sqrtf(3.0f) * new_area / denom;
+    float term = 1.0f - fminf(fmaxf(shapeMetric, 0.0f), 1.0f);
+    skinny_cost += term;
+    num_tri += 1;
+    return true;
+}
+
+
+__global__ void sf_init_state_kernel(int* state_i, double* state_d, int V0, int F0, double thresh0) {
+    state_i[STATE_NUM_VERTICES] = V0;
+    state_i[STATE_NUM_FACES] = F0;
+    state_i[STATE_PREV_NUM_FACES] = F0;
+    state_i[STATE_DONE] = 0;
+    state_i[STATE_NUM_EDGES] = 0;
+    state_i[STATE_ROUNDS] = 0;
+    state_d[0] = thresh0;
+}
+
+
+__global__ void sf_round_begin_kernel(int* state_i) {
+    if (state_i[STATE_DONE]) return;
+    state_i[STATE_PREV_NUM_FACES] = state_i[STATE_NUM_FACES];
+    state_i[STATE_ROUNDS] += 1;
+}
+
+
+// S1: the Python while-loop's termination check and "<1% -> thresh*=10" rule.
+// O2: ratio_thresh/escalation_factor are call parameters (default 1e-2/10.0,
+// i.e. identical decisions to the original hardcoded constants).
+__global__ void sf_decision_kernel(
+    int* state_i, double* state_d, int target_num_faces, double ratio_thresh, double escalation_factor
+) {
+    if (state_i[STATE_DONE]) return;
+    int new_f = state_i[STATE_NUM_FACES];
+    if (new_f <= target_num_faces) {
+        state_i[STATE_DONE] = 1;
+        return;
+    }
+    int prev_f = state_i[STATE_PREV_NUM_FACES];
+    int del_f = prev_f - new_f;
+    if ((double)del_f / (double)prev_f < ratio_thresh) {
+        state_d[0] = state_d[0] * escalation_factor;
+    }
+}
+
+
+// O3: sf_update_counts_kernel + sf_decision_kernel fused (see header "O3").
+__global__ void sf_finish_round_kernel(
+    int* state_i, const int* vertices_map_scanned, const int* faces_map_scanned, int V0, int F0,
+    double* state_d, int target_num_faces, double ratio_thresh, double escalation_factor
+) {
+    state_i[STATE_NUM_VERTICES] = vertices_map_scanned[V0];
+    state_i[STATE_NUM_FACES] = faces_map_scanned[F0];
+
+    if (state_i[STATE_DONE]) return;
+    int new_f = state_i[STATE_NUM_FACES];
+    if (new_f <= target_num_faces) {
+        state_i[STATE_DONE] = 1;
+        return;
+    }
+    int prev_f = state_i[STATE_PREV_NUM_FACES];
+    int del_f = prev_f - new_f;
+    if ((double)del_f / (double)prev_f < ratio_thresh) {
+        state_d[0] = state_d[0] * escalation_factor;
+    }
+}
+
+
+__global__ void sf_get_neighbor_face_cnt_kernel(
+    const int3* faces, const int* d_num_faces, const int* d_done, int F0, int* neighbor_face_cnt
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= F0) return;
+    if (*d_done) return;
+    if (tid >= *d_num_faces) return;
+    int3 f = faces[tid];
+    atomicAdd(&neighbor_face_cnt[f.x], 1);
+    atomicAdd(&neighbor_face_cnt[f.y], 1);
+    atomicAdd(&neighbor_face_cnt[f.z], 1);
+}
+
+
+__global__ void sf_fill_neighbor_face_ids_kernel(
+    const int3* faces, const int* d_num_faces, const int* d_done, int F0,
+    int* neighbor_face_ids, int* neighbor_face_ids_offset, int* neighbor_face_cnt
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= F0) return;
+    if (*d_done) return;
+    if (tid >= *d_num_faces) return;
+    int3 f = faces[tid];
+    neighbor_face_ids[neighbor_face_ids_offset[f.x] + atomicAdd(&neighbor_face_cnt[f.x], 1)] = tid;
+    neighbor_face_ids[neighbor_face_ids_offset[f.y] + atomicAdd(&neighbor_face_cnt[f.y], 1)] = tid;
+    neighbor_face_ids[neighbor_face_ids_offset[f.z] + atomicAdd(&neighbor_face_cnt[f.z], 1)] = tid;
+}
+
+
+// expand_edges_kernel + ghost-sentinel padding (S2). O1: key_shift is 32
+// (fixed encoding) unless compact_edge_bits, in which case it's K =
+// ceil(log2(V0+1)) -- see header "O1"; either way the encoding is an
+// order-preserving injection, so the sort/RLE output is unaffected.
+__global__ void sf_expand_edges_padded_kernel(
+    const int3* faces, const int* d_num_faces, const int* d_done, int F0, int ghost_vid,
+    int key_shift, uint64_t* edges_raw
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= F0) return;
+    if (*d_done) return;
+    int base = tid * 3;
+    if (tid < *d_num_faces) {
+        int3 f = faces[tid];
+        edges_raw[base + 0] = ((uint64_t)min(f.x, f.y) << key_shift) | (uint32_t)max(f.x, f.y);
+        edges_raw[base + 1] = ((uint64_t)min(f.y, f.z) << key_shift) | (uint32_t)max(f.y, f.z);
+        edges_raw[base + 2] = ((uint64_t)min(f.z, f.x) << key_shift) | (uint32_t)max(f.z, f.x);
+    } else {
+        uint64_t sentinel = ((uint64_t)(uint32_t)ghost_vid << key_shift) | (uint32_t)ghost_vid;
+        edges_raw[base + 0] = sentinel;
+        edges_raw[base + 1] = sentinel;
+        edges_raw[base + 2] = sentinel;
+    }
+}
+
+
+// S3: boundary vertices straight from the RLE multiplicity.
+__global__ void sf_mark_boundary_vertices_kernel(
+    const uint64_t* edges, const int* edge_multiplicity, const int* d_num_edges, const int* d_done, int E0,
+    int ghost_vid, int key_shift, uint64_t key_mask, uint8_t* vert_is_boundary
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= E0) return;
+    if (*d_done) return;
+    if (tid >= *d_num_edges) return;
+    if (edge_multiplicity[tid] != 1) return;
+    uint64_t e = edges[tid];
+    int e0 = int(e >> key_shift);
+    int e1 = int(e & key_mask);
+    if (e0 == ghost_vid) return; // defensive; the ghost run's multiplicity is never 1
+    vert_is_boundary[e0] = 1;
+    vert_is_boundary[e1] = 1;
+}
+
+
+__global__ void sf_get_qem_kernel(
+    const float3* vertices, const int3* faces, const int* vert2face, const int* vert2face_offset,
+    const int* d_num_vertices, const int* d_done, int V0, QEM* qems
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= V0) return;
+    if (*d_done) return;
+    if (tid >= *d_num_vertices) return;
+    QEM v_qem;
+    for (int f = vert2face_offset[tid]; f < vert2face_offset[tid + 1]; f++) {
+        int3 f_vids = faces[vert2face[f]];
+        Vec3f f_v0(vertices[f_vids.x]);
+        Vec3f e1(vertices[f_vids.y]);
+        Vec3f e2(vertices[f_vids.z]);
+        e1 -= f_v0;
+        e2 -= f_v0;
+        Vec3f n = e1.cross(e2);
+        n.normalize();
+        float d = -(n.dot(f_v0));
+        v_qem.add_plane({ n.x, n.y, n.z, d });
+    }
+    qems[tid] = v_qem;
+}
+
+
+__global__ void sf_get_edge_collapse_cost_kernel(
+    const float3* vertices, const int3* faces,
+    const int* vert2face, const int* vert2face_offset,
+    const uint64_t* edges, const uint8_t* vert_is_boundary, const QEM* qems,
+    const int* d_num_edges, const int* d_done, int E0, int ghost_vid,
+    int key_shift, uint64_t key_mask,
+    const float lambda_edge_length, const float lambda_skinny,
+    float* edge_collapse_costs
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= E0) return;
+    if (*d_done) return;
+    if (tid >= *d_num_edges) return;
+
+    // get edge
+    uint64_t e = edges[tid];
+    int e0 = int(e >> key_shift);
+    int e1 = int(e & key_mask);
+    if (e0 == ghost_vid) return;
+
+    // get edge vertices
+    Vec3f v0(vertices[e0]);
+    Vec3f v1(vertices[e1]);
+    uint8_t v0_is_bound = vert_is_boundary[e0];
+    uint8_t v1_is_bound = vert_is_boundary[e1];
+    float w0 = 0.5;
+    if (v0_is_bound && !v1_is_bound) w0 = 1.0;
+    else if (!v0_is_bound &&  v1_is_bound) w0 = 0.0;
+    Vec3f v = v0 * w0 + v1 * (1.0f - w0);
+
+    float cost = 0.0f;
+
+    // QEM cost
+    QEM edge_qem = qems[e0] + qems[e1];
+    float qem_cost = edge_qem.evaluate(v);
+    cost += qem_cost;
+
+    // edge length cost
+    float edge_length2 = (v1 - v0).norm2();
+    cost += lambda_edge_length * edge_length2;
+
+    // skinny cost
+    float skinny_cost = 0.0f;
+    int num_tri = 0;
+    for (int f = vert2face_offset[e0]; f < vert2face_offset[e0+1]; f++) {
+        int tri_idx = vert2face[f];
+        if (!sf_process_incident_tri(tri_idx, e0, e1, vertices, faces, v, skinny_cost, num_tri)) {
+            edge_collapse_costs[tid] = INFINITY;
+            return;
+        }
+    }
+    for (int f = vert2face_offset[e1]; f < vert2face_offset[e1+1]; f++) {
+        int tri_idx = vert2face[f];
+        if (!sf_process_incident_tri(tri_idx, e1, e0, vertices, faces, v, skinny_cost, num_tri)) {
+            edge_collapse_costs[tid] = INFINITY;
+            return;
+        }
+    }
+    if (num_tri > 0) {
+        skinny_cost /= num_tri;
+    }
+    cost += lambda_skinny * skinny_cost * edge_length2;
+
+    edge_collapse_costs[tid] = cost;
+}
+
+
+__global__ void sf_propagate_cost_kernel(
+    const uint64_t* edges, const int* vert2face, const int* vert2face_offset,
+    const float* edge_collapse_costs, const int* d_num_edges, const int* d_done, int E0, int ghost_vid,
+    int key_shift, uint64_t key_mask,
+    uint64_t* propagated_costs
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= E0) return;
+    if (*d_done) return;
+    if (tid >= *d_num_edges) return;
+
+    // get edge
+    uint64_t e = edges[tid];
+    int e0 = int(e >> key_shift);
+    int e1 = int(e & key_mask);
+    if (e0 == ghost_vid) return;
+
+    uint64_t cost = sf_pack_key_value_positive(tid, edge_collapse_costs[tid]);
+
+    // propagate cost to neighboring faces
+    for (int f = vert2face_offset[e0]; f < vert2face_offset[e0+1]; f++) {
+        atomicMin(reinterpret_cast<unsigned long long*>(&propagated_costs[vert2face[f]]), static_cast<unsigned long long>(cost));
+    }
+    for (int f = vert2face_offset[e1]; f < vert2face_offset[e1+1]; f++) {
+        atomicMin(reinterpret_cast<unsigned long long*>(&propagated_costs[vert2face[f]]), static_cast<unsigned long long>(cost));
+    }
+}
+
+
+// S4: fixed-size replacement for `fill(1)`: 1 for the real prefix, 0 for the
+// padding tail. NOT guarded by the done flag (B1): after convergence it
+// re-derives the identity map every round.
+__global__ void sf_mark_valid_kernel(int* map, const int* d_count, int N) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid > N) return; // map has N+1 slots: [0, N]
+    map[tid] = (tid < *d_count) ? 1 : 0;
+}
+
+
+__global__ void sf_collapse_edges_kernel(
+    float3* vertices, int3* faces, const uint64_t* edges,
+    const int* vert2face, const int* vert2face_offset,
+    const float* edge_collapse_costs, const uint64_t* propagated_costs,
+    const uint8_t* vert_is_boundary,
+    const int* d_num_edges, int E0, int ghost_vid,
+    int key_shift, uint64_t key_mask,
+    const double* d_thresh, const int* d_done,
+    int* vertices_kept, int* faces_kept
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= E0) return;
+    if (*d_done) return;
+    if (tid >= *d_num_edges) return;
+
+    // get edge
+    uint64_t e = edges[tid];
+    int e0 = int(e >> key_shift);
+    int e1 = int(e & key_mask);
+    if (e0 == ghost_vid) return;
+
+    // B2: the double threshold is cast to float exactly like the Python
+    // double -> C++ float argument of simplify_step().
+    const float collapse_thresh = static_cast<float>(*d_thresh);
+    float cost = edge_collapse_costs[tid];
+    if (cost > collapse_thresh) return;
+
+    uint64_t pack = sf_pack_key_value_positive(tid, cost);
+
+    for (int f = vert2face_offset[e0]; f < vert2face_offset[e0+1]; f++) {
+        if (propagated_costs[vert2face[f]] != pack) return;
+    }
+    for (int f = vert2face_offset[e1]; f < vert2face_offset[e1+1]; f++) {
+        if (propagated_costs[vert2face[f]] != pack) return;
+    }
+
+    // collapse edge
+    Vec3f v0(vertices[e0]);
+    Vec3f v1(vertices[e1]);
+    uint8_t v0_is_bound = vert_is_boundary[e0];
+    uint8_t v1_is_bound = vert_is_boundary[e1];
+    float w0 = 0.5;
+    if (v0_is_bound && !v1_is_bound) w0 = 1.0;
+    else if (!v0_is_bound &&  v1_is_bound) w0 = 0.0;
+    Vec3f v_new = v0 * w0 + v1 * (1.0f - w0);
+    vertices[e0] = { v_new.x, v_new.y, v_new.z };
+    vertices_kept[e1] = 0;
+    // delete shared faces
+    for (int f = vert2face_offset[e0]; f < vert2face_offset[e0+1]; f++) {
+        int fid = vert2face[f];
+        int3 f_vids = faces[fid];
+        if (f_vids.x == e1 || f_vids.y == e1 || f_vids.z == e1) {
+            faces_kept[fid] = 0;
+        }
+    }
+    // update faces
+    for (int f = vert2face_offset[e1]; f < vert2face_offset[e1+1]; f++) {
+        int fid = vert2face[f];
+        int3 f_vids = faces[fid];
+        if (f_vids.x == e1) {
+            f_vids.x = e0;
+        } else if (f_vids.y == e1) {
+            f_vids.y = e0;
+        } else if (f_vids.z == e1) {
+            f_vids.z = e0;
+        }
+        faces[fid] = f_vids;
+    }
+}
+
+
+__global__ void sf_compress_vertices_kernel(
+    const int* vertices_map_scanned, const float3* old_vertices, const int* d_num_vertices_old, int V0,
+    float3* new_vertices
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= V0) return;
+    if (tid >= *d_num_vertices_old) return;
+    int new_id = vertices_map_scanned[tid];
+    int is_kept = vertices_map_scanned[tid + 1] == new_id + 1;
+    if (is_kept) {
+        new_vertices[new_id] = old_vertices[tid];
+    }
+}
+
+
+__global__ void sf_compress_faces_kernel(
+    const int* faces_map_scanned, const int* vertices_map_scanned, const int3* old_faces,
+    const int* d_num_faces_old, int F0, int3* new_faces
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= F0) return;
+    if (tid >= *d_num_faces_old) return;
+    int new_id = faces_map_scanned[tid];
+    int is_kept = faces_map_scanned[tid + 1] == new_id + 1;
+    if (is_kept) {
+        new_faces[new_id].x = vertices_map_scanned[old_faces[tid].x];
+        new_faces[new_id].y = vertices_map_scanned[old_faces[tid].y];
+        new_faces[new_id].z = vertices_map_scanned[old_faces[tid].z];
+    }
+}
+
+
+// S4: device-to-device copy of the new counts from the fixed-index end of
+// the scanned maps.
+__global__ void sf_update_counts_kernel(
+    int* state_i, const int* vertices_map_scanned, const int* faces_map_scanned, int V0, int F0
+) {
+    state_i[STATE_NUM_VERTICES] = vertices_map_scanned[V0];
+    state_i[STATE_NUM_FACES] = faces_map_scanned[F0];
+}
+
+
+struct SfArena {
+    char* base = nullptr;
+    size_t offset = 0;
+    bool dry_run = true;
+
+    template<typename T>
+    T* take(size_t n) {
+        size_t bytes = n * sizeof(T);
+        bytes = (bytes + 255) & ~size_t(255);
+        T* p = dry_run ? nullptr : reinterpret_cast<T*>(base + offset);
+        offset += bytes;
+        return p;
+    }
+};
+
+
+struct SfCtx {
+    int V0 = 0, F0 = 0, E0 = 0;
+    int* state_i = nullptr;
+    double* state_d = nullptr;
+    int* vert2face_cnt = nullptr;     // V0 + 1
+    int* vert2face_offset = nullptr;  // V0 + 1
+    int* vert2face = nullptr;         // E0
+    uint64_t* edges_raw = nullptr;    // E0
+    uint64_t* edges_sorted = nullptr; // E0
+    uint64_t* edges = nullptr;        // E0 (RLE unique out)
+    int* edge_cnt = nullptr;          // E0 (RLE counts out)
+    uint8_t* vert_is_boundary = nullptr; // V0
+    QEM* qem = nullptr;               // V0
+    float* edge_cost = nullptr;       // E0
+    uint64_t* propagated = nullptr;   // F0
+    int* vertices_map = nullptr;      // V0 + 1
+    int* faces_map = nullptr;         // F0 + 1
+    float3* vertices_pong = nullptr;  // V0
+    int3* faces_pong = nullptr;       // F0
+    char* cub_temp = nullptr;
+    size_t cub_temp_bytes = 0;
+
+    void carve(SfArena& a) {
+        state_i = a.take<int>(STATE_SIZE);
+        state_d = a.take<double>(1);
+        vert2face_cnt = a.take<int>(V0 + 1);
+        vert2face_offset = a.take<int>(V0 + 1);
+        vert2face = a.take<int>(E0);
+        edges_raw = a.take<uint64_t>(E0);
+        edges_sorted = a.take<uint64_t>(E0);
+        edges = a.take<uint64_t>(E0);
+        edge_cnt = a.take<int>(E0);
+        vert_is_boundary = a.take<uint8_t>(V0);
+        qem = a.take<QEM>(V0);
+        edge_cost = a.take<float>(E0);
+        propagated = a.take<uint64_t>(F0);
+        vertices_map = a.take<int>(V0 + 1);
+        faces_map = a.take<int>(F0 + 1);
+        vertices_pong = a.take<float3>(V0);
+        faces_pong = a.take<int3>(F0);
+        cub_temp = a.take<char>(cub_temp_bytes);
+    }
+};
+
+
+// O1: end_bit is the actual bit range the runtime sort call will use (64
+// unless compact_edge_bits) -- sized for that range so the arena's cub_temp
+// is never under-allocated for a narrower (equal-or-smaller-temp) sort.
+size_t sf_query_cub_temp(SfCtx& c, cudaStream_t stream, int end_bit) {
+    size_t bytes, max_bytes = 0;
+    bytes = 0;
+    CUDA_CHECK(cub::DeviceScan::ExclusiveSum(nullptr, bytes, c.vert2face_cnt, c.vert2face_offset, c.V0 + 1, stream));
+    max_bytes = std::max(max_bytes, bytes);
+    bytes = 0;
+    CUDA_CHECK(cub::DeviceRadixSort::SortKeys(nullptr, bytes, c.edges_raw, c.edges_sorted, c.E0, 0, end_bit, stream));
+    max_bytes = std::max(max_bytes, bytes);
+    bytes = 0;
+    CUDA_CHECK(cub::DeviceRunLengthEncode::Encode(nullptr, bytes, c.edges_sorted, c.edges, c.edge_cnt, c.state_i + STATE_NUM_EDGES, c.E0, stream));
+    max_bytes = std::max(max_bytes, bytes);
+    bytes = 0;
+    CUDA_CHECK(cub::DeviceScan::ExclusiveSum(nullptr, bytes, c.vertices_map, c.V0 + 1, stream));
+    max_bytes = std::max(max_bytes, bytes);
+    bytes = 0;
+    CUDA_CHECK(cub::DeviceScan::ExclusiveSum(nullptr, bytes, c.faces_map, c.F0 + 1, stream));
+    max_bytes = std::max(max_bytes, bytes);
+    return max_bytes;
+}
+
+} // anonymous namespace
+
+
+std::vector<int> CuMesh::simplify_sync_free(
+    float lambda_edge_length,
+    float lambda_skinny,
+    double initial_thresh,
+    int target_num_faces,
+    int max_rounds,
+    int sync_every,
+    bool compact_edge_bits,
+    double ratio_thresh,
+    double escalation_factor,
+    bool fuse_round_kernels,
+    bool use_cuda_graph
+) {
+    cudaStream_t stream = current_stream();
+
+    const int V0 = static_cast<int>(this->vertices.size);
+    const int F0 = static_cast<int>(this->faces.size);
+    if (F0 <= target_num_faces) {
+        return std::vector<int>{V0, F0, 0, 1};
+    }
+    TORCH_CHECK(max_rounds > 0, "[CuMesh] simplify_sync_free: max_rounds must be positive");
+    TORCH_CHECK(sync_every >= 0, "[CuMesh] simplify_sync_free: sync_every must be >= 0");
+    const int GHOST = V0;
+    const int E0 = F0 * 3;
+
+    // O1: key_shift/key_mask/end_bit for the (min,max) edge sort key -- see
+    // header "O1". compact_edge_bits=false reproduces the fixed 32/64
+    // encoding exactly (key_shift=32, key_mask=0xFFFFFFFF, end_bit=64).
+    const int key_shift = compact_edge_bits ? sf_bits_needed(V0) : 32;
+    const uint64_t key_mask = (key_shift >= 32) ? uint64_t(0xFFFFFFFFu) : ((uint64_t(1) << key_shift) - 1);
+    const int end_bit = compact_edge_bits ? 2 * key_shift : int(sizeof(uint64_t) * 8);
+
+    SfCtx c;
+    c.V0 = V0; c.F0 = F0; c.E0 = E0;
+
+    SfArena arena;
+    arena.dry_run = true;
+    c.cub_temp_bytes = 0;
+    c.carve(arena);
+    c.cub_temp_bytes = sf_query_cub_temp(c, stream, end_bit);
+    arena.offset = 0;
+    c.carve(arena);
+    const size_t total_bytes = arena.offset;
+    CUDA_CHECK(cudaMalloc(&arena.base, total_bytes));
+    arena.dry_run = false;
+    arena.offset = 0;
+    c.carve(arena);
+
+    const int grid_V0 = (V0 + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    const int grid_V0p1 = (V0 + 1 + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    const int grid_F0 = (F0 + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    const int grid_F0p1 = (F0 + 1 + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    const int grid_E0 = (E0 + BLOCK_SIZE - 1) / BLOCK_SIZE;
+
+    // Ping-pong partner for this->vertices / this->faces. The mesh buffers
+    // keep their capacity (>= V0/F0); their .size is fixed up at the end.
+    Buffer<float3> vertices_pong; vertices_pong.ptr = c.vertices_pong; vertices_pong.size = V0; vertices_pong.capacity = V0;
+    Buffer<int3> faces_pong; faces_pong.ptr = c.faces_pong; faces_pong.size = F0; faces_pong.capacity = F0;
+    // Remember which raw pointer belongs to the arena so we can put the
+    // mesh's own allocation back into this->vertices/faces at the end
+    // regardless of swap parity (the arena is freed here).
+    float3* mesh_vertices_ptr = this->vertices.ptr;
+    int3* mesh_faces_ptr = this->faces.ptr;
+    const size_t mesh_vertices_capacity = this->vertices.capacity;
+    const size_t mesh_faces_capacity = this->faces.capacity;
+
+    sf_init_state_kernel<<<1, 1, 0, stream>>>(c.state_i, c.state_d, V0, F0, initial_thresh);
+    CUDA_CHECK(cudaGetLastError());
+
+    const int* d_done = c.state_i + STATE_DONE;
+    const int* d_nv = c.state_i + STATE_NUM_VERTICES;
+    const int* d_nf = c.state_i + STATE_NUM_FACES;
+    const int* d_ne = c.state_i + STATE_NUM_EDGES;
+
+    // One round's kernel sequence, factored into a callable so it can be
+    // issued either directly (the plain path) or once, under
+    // stream capture, for O4 (use_cuda_graph). Every pointer/grid size it
+    // touches is fixed for the whole call (the arena, V0/F0/E0, this->
+    // vertices.ptr/this->faces.ptr -- note these two are swapped with the
+    // pong buffers INSIDE this lambda, which is fine even for a captured
+    // graph: the swap only exchanges which of the two ALREADY-CAPTURED
+    // pointers a later replay's kernels read/write via the closure's own
+    // `this` / `vertices_pong`/`faces_pong` references -- see the graph
+    // path below for why this still requires care).
+    auto run_round = [&]() {
+        // O4: re-fetch the current stream on every call rather than closing
+        // over the outer `stream` variable -- during graph capture this
+        // must be the dedicated capture-only pooled stream (see O4 below),
+        // never the shared stream the rest of this function/process uses;
+        // outside capture (the normal path, and at/after replay) torch's
+        // current stream is unchanged from the outer `stream`, so this is a
+        // no-op there. Shadows the outer `stream` for the rest of this
+        // lambda body -- every launch below already reads `stream` by name.
+        cudaStream_t stream = current_stream();
+        sf_round_begin_kernel<<<1, 1, 0, stream>>>(c.state_i);
+        CUDA_CHECK(cudaGetLastError());
+
+        // 1. vertex-face adjacency
+        CUDA_CHECK(cudaMemsetAsync(c.vert2face_cnt, 0, (V0 + 1) * sizeof(int), stream));
+        sf_get_neighbor_face_cnt_kernel<<<grid_F0, BLOCK_SIZE, 0, stream>>>(
+            this->faces.ptr, d_nf, d_done, F0, c.vert2face_cnt);
+        CUDA_CHECK(cudaGetLastError());
+        {
+            size_t bytes = c.cub_temp_bytes;
+            CUDA_CHECK(cub::DeviceScan::ExclusiveSum(c.cub_temp, bytes, c.vert2face_cnt, c.vert2face_offset, V0 + 1, stream));
+        }
+        CUDA_CHECK(cudaMemsetAsync(c.vert2face_cnt, 0, (V0 + 1) * sizeof(int), stream));
+        sf_fill_neighbor_face_ids_kernel<<<grid_F0, BLOCK_SIZE, 0, stream>>>(
+            this->faces.ptr, d_nf, d_done, F0, c.vert2face, c.vert2face_offset, c.vert2face_cnt);
+        CUDA_CHECK(cudaGetLastError());
+        if (this->deterministic) {
+            // DETERMINISTIC MODE: fix the (atomic, hardware-ordered) order of
+            // each vertex's face list -- the summation order of the QEM and
+            // skinny terms -- exactly like get_vertex_face_adjacency() does
+            // in the original path when CuMesh::deterministic is set.
+            sort_csr_segments_kernel<int><<<grid_V0, BLOCK_SIZE, 0, stream>>>(
+                c.vert2face, c.vert2face_offset, V0, d_nv, d_done);
+            CUDA_CHECK(cudaGetLastError());
+        }
+
+        // 2. edges: pad + sort + RLE, count stays on-device (S2, O1)
+        sf_expand_edges_padded_kernel<<<grid_F0, BLOCK_SIZE, 0, stream>>>(
+            this->faces.ptr, d_nf, d_done, F0, GHOST, key_shift, c.edges_raw);
+        CUDA_CHECK(cudaGetLastError());
+        {
+            size_t bytes = c.cub_temp_bytes;
+            CUDA_CHECK(cub::DeviceRadixSort::SortKeys(
+                c.cub_temp, bytes, c.edges_raw, c.edges_sorted, E0, 0, end_bit, stream));
+        }
+        {
+            size_t bytes = c.cub_temp_bytes;
+            CUDA_CHECK(cub::DeviceRunLengthEncode::Encode(
+                c.cub_temp, bytes, c.edges_sorted, c.edges, c.edge_cnt, c.state_i + STATE_NUM_EDGES, E0, stream));
+        }
+
+        // 3. boundary vertices (S3)
+        CUDA_CHECK(cudaMemsetAsync(c.vert_is_boundary, 0, V0 * sizeof(uint8_t), stream));
+        sf_mark_boundary_vertices_kernel<<<grid_E0, BLOCK_SIZE, 0, stream>>>(
+            c.edges, c.edge_cnt, d_ne, d_done, E0, GHOST, key_shift, key_mask, c.vert_is_boundary);
+        CUDA_CHECK(cudaGetLastError());
+
+        // 4. QEM
+        sf_get_qem_kernel<<<grid_V0, BLOCK_SIZE, 0, stream>>>(
+            this->vertices.ptr, this->faces.ptr, c.vert2face, c.vert2face_offset, d_nv, d_done, V0, c.qem);
+        CUDA_CHECK(cudaGetLastError());
+
+        // 5. edge collapse cost
+        sf_get_edge_collapse_cost_kernel<<<grid_E0, BLOCK_SIZE, 0, stream>>>(
+            this->vertices.ptr, this->faces.ptr, c.vert2face, c.vert2face_offset,
+            c.edges, c.vert_is_boundary, c.qem, d_ne, d_done, E0, GHOST, key_shift, key_mask,
+            lambda_edge_length, lambda_skinny, c.edge_cost);
+        CUDA_CHECK(cudaGetLastError());
+
+        // 6. propagate cost
+        fill_kernel<uint64_t><<<grid_F0, BLOCK_SIZE, 0, stream>>>(
+            c.propagated, F0, std::numeric_limits<uint64_t>::max());
+        CUDA_CHECK(cudaGetLastError());
+        sf_propagate_cost_kernel<<<grid_E0, BLOCK_SIZE, 0, stream>>>(
+            c.edges, c.vert2face, c.vert2face_offset, c.edge_cost, d_ne, d_done, E0, GHOST, key_shift, key_mask, c.propagated);
+        CUDA_CHECK(cudaGetLastError());
+
+        // 7. valid maps (always), then collapse (skipped once done) -- B1
+        sf_mark_valid_kernel<<<grid_V0p1, BLOCK_SIZE, 0, stream>>>(c.vertices_map, d_nv, V0);
+        CUDA_CHECK(cudaGetLastError());
+        sf_mark_valid_kernel<<<grid_F0p1, BLOCK_SIZE, 0, stream>>>(c.faces_map, d_nf, F0);
+        CUDA_CHECK(cudaGetLastError());
+        sf_collapse_edges_kernel<<<grid_E0, BLOCK_SIZE, 0, stream>>>(
+            this->vertices.ptr, this->faces.ptr, c.edges, c.vert2face, c.vert2face_offset,
+            c.edge_cost, c.propagated, c.vert_is_boundary, d_ne, E0, GHOST, key_shift, key_mask,
+            c.state_d, d_done, c.vertices_map, c.faces_map);
+        CUDA_CHECK(cudaGetLastError());
+
+        // 8. compact (scan + compress); identity once done (S4, B1)
+        {
+            size_t bytes = c.cub_temp_bytes;
+            CUDA_CHECK(cub::DeviceScan::ExclusiveSum(c.cub_temp, bytes, c.vertices_map, V0 + 1, stream));
+        }
+        {
+            size_t bytes = c.cub_temp_bytes;
+            CUDA_CHECK(cub::DeviceScan::ExclusiveSum(c.cub_temp, bytes, c.faces_map, F0 + 1, stream));
+        }
+        sf_compress_vertices_kernel<<<grid_V0, BLOCK_SIZE, 0, stream>>>(
+            c.vertices_map, this->vertices.ptr, d_nv, V0, vertices_pong.ptr);
+        CUDA_CHECK(cudaGetLastError());
+        sf_compress_faces_kernel<<<grid_F0, BLOCK_SIZE, 0, stream>>>(
+            c.faces_map, c.vertices_map, this->faces.ptr, d_nf, F0, faces_pong.ptr);
+        CUDA_CHECK(cudaGetLastError());
+        swap_buffers(this->vertices, vertices_pong);
+        swap_buffers(this->faces, faces_pong);
+
+        // 9. counts update + threshold/termination decision (S4, S1, O3)
+        if (fuse_round_kernels) {
+            sf_finish_round_kernel<<<1, 1, 0, stream>>>(
+                c.state_i, c.vertices_map, c.faces_map, V0, F0, c.state_d, target_num_faces,
+                ratio_thresh, escalation_factor);
+            CUDA_CHECK(cudaGetLastError());
+        } else {
+            sf_update_counts_kernel<<<1, 1, 0, stream>>>(c.state_i, c.vertices_map, c.faces_map, V0, F0);
+            CUDA_CHECK(cudaGetLastError());
+            sf_decision_kernel<<<1, 1, 0, stream>>>(c.state_i, c.state_d, target_num_faces, ratio_thresh, escalation_factor);
+            CUDA_CHECK(cudaGetLastError());
+        }
+    };
+
+    // O4: capture one round into a graph and replay it instead of manually
+    // issuing every kernel launch each round -- see header "O4". Captured
+    // on a DEDICATED pooled stream (at::cuda::getStreamFromPool()), not the
+    // shared stream the rest of this call/process uses: capturing the
+    // shared stream directly hit "operation
+    // not permitted when stream is capturing" from unrelated CUDA activity
+    // on that same widely-shared stream (elsewhere in the process) racing
+    // the capture window; at::cuda::CUDAGraph::capture_begin()/capture_end()
+    // additionally coordinate with c10's CUDA caching allocator the way a
+    // raw cudaStreamBeginCapture does not. run_round() re-fetches "the
+    // current stream" itself (see its own comment) so its kernels land on
+    // whichever stream is current at each call -- the capture stream while
+    // inside the CUDAStreamGuard below, the original `stream` otherwise.
+    //
+    // IMPORTANT: run_round() swaps this->vertices/this->faces with
+    // vertices_pong/faces_pong (host-side pointer swap, not a device op)
+    // every time it runs; a captured graph's kernels are bound to whichever
+    // concrete device pointers were live at CAPTURE time and do not
+    // "follow" that swap on replay. Since there are only ever two physical
+    // buffers in play (the mesh's own allocation and the arena's pong), a
+    // graph captured while (vertices.ptr, pong.ptr) = (A, B) would, if
+    // replayed directly, keep reading/writing (A, B) every round instead of
+    // alternating (A,B),(B,A),(A,B),... -- silently wrong. This is handled
+    // by capturing TWO graphs (one per parity) and alternating which one is
+    // launched, so each graph always sees the pointer pair it was captured
+    // with; capture (which only records, never executes) is run for both
+    // parities back-to-back before any real round has executed.
+    bool graph_ok = false;
+    at::cuda::CUDAGraph graph_even, graph_odd;
+
+    if (use_cuda_graph) {
+        // Declared outside the try block (not inside) so the catch block
+        // below can still name it for cleanup -- a variable declared
+        // inside a try block is out of scope in its catch handler.
+        at::cuda::CUDAStream capture_stream = at::cuda::getStreamFromPool();
+        try {
+            {
+                c10::cuda::CUDAStreamGuard guard(capture_stream);
+                graph_even.capture_begin();
+                run_round();
+                graph_even.capture_end();
+                graph_odd.capture_begin();
+                run_round();
+                graph_odd.capture_end();
+            } // guard destructor restores the original current stream here
+            graph_ok = true;
+        } catch (const std::exception&) {
+            // Capture/instantiation failed: make sure capture_stream isn't
+            // left stuck mid-capture before falling back to the per-kernel-
+            // launch loop below for the whole call (note: by this point the
+            // CUDAStreamGuard above has already been destroyed during stack
+            // unwinding, restoring the current stream -- so check
+            // capture_stream explicitly here, not "the current stream").
+            // graph_even/graph_odd's own destructors clean up whatever
+            // cudaGraph_t/cudaGraphExec_t they did manage to build.
+            cudaStreamCaptureStatus capture_status = cudaStreamCaptureStatusNone;
+            cudaStream_t cs = capture_stream.stream();
+            if (cudaStreamIsCapturing(cs, &capture_status) == cudaSuccess &&
+                capture_status != cudaStreamCaptureStatusNone) {
+                cudaGraph_t aborted = nullptr;
+                cudaStreamEndCapture(cs, &aborted);
+                if (aborted) cudaGraphDestroy(aborted);
+            }
+            graph_even.reset();
+            graph_odd.reset();
+            graph_ok = false;
+        }
+    }
+
+    if (use_cuda_graph && graph_ok) {
+        // The two capture calls above ran round 0's and round 1's kernel
+        // sequences for real (capture only records, it does not execute),
+        // so no rounds have actually happened on-device yet -- replay from
+        // round 0. CUDAGraph::replay() launches on the CURRENT stream,
+        // which at this point (outside the CUDAStreamGuard above) is back
+        // to the original `stream` -- confirmed by using `stream` directly
+        // for the sync_every poll in between replay() calls below.
+        for (int round = 0; round < max_rounds; round++) {
+            (round % 2 == 0 ? graph_even : graph_odd).replay();
+            if (sync_every > 0 && ((round + 1) % sync_every == 0) && (round + 1) < max_rounds) {
+                int h_done = 0;
+                CUDA_CHECK(cudaMemcpyAsync(&h_done, d_done, sizeof(int), cudaMemcpyDeviceToHost, stream));
+                CUDA_CHECK(cudaStreamSynchronize(stream));
+                if (h_done) break;
+            }
+        }
+    } else {
+        for (int round = 0; round < max_rounds; round++) {
+            run_round();
+            if (sync_every > 0 && ((round + 1) % sync_every == 0) && (round + 1) < max_rounds) {
+                int h_done = 0;
+                CUDA_CHECK(cudaMemcpyAsync(&h_done, d_done, sizeof(int), cudaMemcpyDeviceToHost, stream));
+                CUDA_CHECK(cudaStreamSynchronize(stream));
+                if (h_done) break;
+            }
+        }
+    }
+
+    // Make sure the mesh's own allocation ends up holding the result (the
+    // arena's pong is freed below): if the last swap left the result in the
+    // arena buffer, copy it back into the mesh buffer.
+    if (this->vertices.ptr != mesh_vertices_ptr) {
+        CUDA_CHECK(cudaMemcpyAsync(mesh_vertices_ptr, this->vertices.ptr, (size_t)V0 * sizeof(float3), cudaMemcpyDeviceToDevice, stream));
+        this->vertices.ptr = mesh_vertices_ptr;
+        this->vertices.capacity = mesh_vertices_capacity;
+    }
+    if (this->faces.ptr != mesh_faces_ptr) {
+        CUDA_CHECK(cudaMemcpyAsync(mesh_faces_ptr, this->faces.ptr, (size_t)F0 * sizeof(int3), cudaMemcpyDeviceToDevice, stream));
+        this->faces.ptr = mesh_faces_ptr;
+        this->faces.capacity = mesh_faces_capacity;
+    }
+
+    // single D2H readback for the whole call
+    int h_state[STATE_SIZE];
+    CUDA_CHECK(cudaMemcpyAsync(h_state, c.state_i, STATE_SIZE * sizeof(int), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    CUDA_CHECK(cudaFree(arena.base));
+
+    this->vertices.size = h_state[STATE_NUM_VERTICES];
+    this->faces.size = h_state[STATE_NUM_FACES];
+    this->clear_cache();
+
+    return std::vector<int>{h_state[STATE_NUM_VERTICES], h_state[STATE_NUM_FACES], h_state[STATE_ROUNDS], h_state[STATE_DONE]};
+}
+
+
+} // namespace fastpixal3d_cumesh_ns
