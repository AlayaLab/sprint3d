+// atlas_det.cuh -- kernels for the opt-in DETERMINISTIC chart-connectivity
+// mode (CuMesh::deterministic == true), shared verbatim (static, header-only)
+// by the original path (atlas.cu, get_chart_connectivity_det) and the
+// sync-free path (atlas_fast.cu) so both compute bit-identical values.
+//
+// What the deterministic mode replaces (both paths):
+//  D1  cub::DeviceReduce::ReduceByKey's float aggregation of duplicate chart
+//      pairs (a decoupled look-back scan: the association order of partial
+//      sums depends on which predecessor tiles have published an inclusive
+//      prefix at look-back time -> not run-to-run repeatable in float).
+//      -> run starts (det_run_flags_kernel) + int ExclusiveSum +
+//         det_scatter_runs_kernel give the unique keys and run offsets
+//         (all integer, deterministic); the per-run length sum is a
+//         segmented reduce over the sorted lengths (cub::DeviceSegmentedReduce
+//         in the original path, its AgentReduce replica in the sync-free
+//         path -- same per-segment order).
+//  D2  get_chart_edge_cnt_kernel's float atomicAdd chart perimeters
+//      (hardware-ordered). -> det_chart_perim_kernel: sequential sum over the
+//      chart's incident edges in increasing edge id.
+//  D3  get_chart_edge_adjacency_kernel's atomicAdd slot assignment (order of
+//      each chart's incident-edge list; consumers are order-independent, but
+//      D2 needs a fixed order). -> the (chart, edge) pairs are radix-sorted
+//      (det_expand_chart_keys_kernel + cub::DeviceRadixSort::SortPairs,
+//      stable), giving each chart's edges in increasing edge id.
+// (The fourth source, the atomic order of vert2face lists -- which reaches
+// compute_charts via edge2face -> refine_charts_kernel's candidate order and
+// simplify via the QEM/skinny sums -- is handled by sort_csr_segments_kernel
+// in shared.h, applied in get_vertex_face_adjacency / simplify_fast.cu.)
+#pragma once
+
+#include <cuda.h>
+#include <cuda_runtime.h>
+#include <cstdint>
+#include <climits>
+
+
+namespace fastpixal3d_cumesh_ns {
+
+
+static __global__ void det_run_flags_kernel(const uint64_t* sorted_keys, const int M, int* flags) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= M) return;
+    flags[tid] = (tid == 0 || sorted_keys[tid] != sorted_keys[tid - 1]) ? 1 : 0;
+}
+
+
+// unique_keys[r] / run_offsets[r] for each run r; run_offsets[num_runs] = M;
+// *d_num_runs = number of runs.
+static __global__ void det_scatter_runs_kernel(
+    const uint64_t* sorted_keys, const int* flags, const int* run_index, const int M,
+    uint64_t* unique_keys, int* run_offsets, int* d_num_runs
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= M) return;
+    if (flags[tid]) {
+        int r = run_index[tid];
+        unique_keys[r] = sorted_keys[tid];
+        run_offsets[r] = tid;
+    }
+    if (tid == M - 1) {
+        int n = run_index[tid] + flags[tid];
+        run_offsets[n] = M;
+        *d_num_runs = n;
+    }
+}
+
+
+// (chart, edge) pairs laid out as [2e] = (c0(e), e), [2e+1] = (c1(e), e);
+// entries with e >= E (padding) get key INT_MAX / value -1 so they sort last.
+static __global__ void det_expand_chart_keys_kernel(
+    const uint64_t* chart_adj, const int* d_E, const int E_max, const int* d_skip, int* keys2, int* vals2
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= E_max) return;
+    if (d_skip != nullptr && *d_skip) return;
+    if (d_E != nullptr && tid >= *d_E) {
+        keys2[2 * tid] = INT_MAX;
+        keys2[2 * tid + 1] = INT_MAX;
+        vals2[2 * tid] = -1;
+        vals2[2 * tid + 1] = -1;
+        return;
+    }
+    uint64_t c = chart_adj[tid];
+    int c0 = int(c >> 32);
+    int c1 = int(c & 0xFFFFFFFF);
+    keys2[2 * tid] = c0;
+    keys2[2 * tid + 1] = c1;
+    vals2[2 * tid] = tid;
+    vals2[2 * tid + 1] = tid;
+}
+
+
+// perim[c] = sum of the lengths of chart c's incident edges, in increasing
+// edge id (chart2edge is sorted per chart).
+static __global__ void det_chart_perim_kernel(
+    const int* chart2edge, const int* chart2edge_offset, const float* chart_adj_length,
+    const int* d_C, const int C_max, const int* d_skip, float* chart_perims
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= C_max) return;
+    if (d_skip != nullptr && *d_skip) return;
+    if (d_C != nullptr && tid >= *d_C) return;
+    float s = 0.0f;
+    for (int k = chart2edge_offset[tid]; k < chart2edge_offset[tid + 1]; k++) {
+        s += chart_adj_length[chart2edge[k]];
+    }
+    chart_perims[tid] = s;
+}
+
+
+} // namespace fastpixal3d_cumesh_ns
