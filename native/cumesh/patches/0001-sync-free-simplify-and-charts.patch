+// ---------------------------------------------------------------------------
+// Scratch arena: one cudaMalloc for everything (H9).
+// ---------------------------------------------------------------------------
+struct Arena {
+    char* base = nullptr;
+    size_t offset = 0;
+    bool dry_run = true;
+
+    template<typename T>
+    T* take(size_t n) {
+        size_t bytes = n * sizeof(T);
+        bytes = (bytes + 255) & ~size_t(255);
+        T* p = dry_run ? nullptr : reinterpret_cast<T*>(base + offset);
+        offset += bytes;
+        return p;
+    }
+};
